# Copy to .env in this folder (same directory as docker-compose.yml). .env is gitignored.
# Docker Compose reads .env here for ${...} substitution in docker-compose.yml.
CONNECTION_STRINGS__DEFAULT_CONNECTION=Host=postgres;Port=5432;Database=kelli_photo;Username=kelli_photo_app;Password=;Timeout=30;Command Timeout=30;Pooling=true;MinPoolSize=0;MaxPoolSize=100

# GitHub Actions: store this value in repository secret CONNECTION_STRINGS__DEFAULT_CONNECTION,
# then in the workflow job that runs compose:
#   env:
#     CONNECTION_STRINGS__DEFAULT_CONNECTION: ${{ secrets.CONNECTION_STRINGS__DEFAULT_CONNECTION }}
#   run: docker compose -f docker/docker-compose.yml up -d
