<Project>
  <PropertyGroup>
    <SemVerBase Condition="'$(SemVerBase)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</SemVerBase>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">$(SemVerBase)</ApplicationVersion>
    <Version>$(SemVerBase)</Version>
    <AssemblyVersion>$(SemVerBase).0</AssemblyVersion>
    <FileVersion>$(SemVerBase).0</FileVersion>
    <InformationalVersion>$(ApplicationVersion)</InformationalVersion>
    <!-- We set build metadata in CI; avoid SDK appending another full git SHA. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
