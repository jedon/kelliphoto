@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using KelliPhoto.Web.Data.Models
@using KelliPhoto.Web.Services
@using KelliPhoto.Web.Components
@using SixLabors.ImageSharp
@attribute [Authorize(Roles = "Admin")]
@inject IFolderService FolderService
@inject IPhotoService PhotoService
@inject IPathService PathService
@inject IConfiguration Configuration
@inject ILogger<Admin> Logger
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Admin - KelliPhoto</PageTitle>

<div class="container mt-4 admin-page">
    <h1>Admin Management</h1>

    <div class="row mt-4">
        <div class="col-12">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "gallery" ? "active" : "")" @onclick="@(() => SetActiveTab("gallery"))">Gallery</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "scanning" ? "active" : "")" @onclick="@(() => SetActiveTab("scanning"))">Scanning</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "users" ? "active" : "")" @onclick="@(() => SetActiveTab("users"))">Users</button>
                </li>
            </ul>
        </div>
    </div>

    <div class="tab-content mt-3">
        @if (activeTab == "gallery")
        {
            <div class="row admin-gallery-layout">
                <div class="col-lg-4 col-md-5">
                    <h3 class="h5">Folders</h3>
                    <p class="text-muted small">Expand nodes to load children. Select a folder to edit settings and photos.</p>
                    <AdminFolderTree SelectedFolderId="selectedFolderId" SelectedFolderIdChanged="OnFolderSelectedAsync" IncludeHidden="true" />
                </div>
                <div class="col-lg-8 col-md-7">
                    @if (selectedFolder == null)
                    {
                        <p class="text-muted mt-4">Select a folder from the tree.</p>
                    }
                    else
                    {
                        <div class="mb-4">
                            <h3 class="h5">Child albums</h3>
                            <p class="text-muted small">Create, reorder, show/hide, tag, or delete albums under @selectedFolder.Name.</p>
                            <AlbumAdminPanel Albums="childAlbums"
                                             ParentFolderId="selectedFolderId"
                                             Thumbnails="childThumbnails"
                                             OnChanged="ReloadChildAlbumsAsync"
                                             OnEditAlbum="OpenEditDialog"
                                             OnOpenAlbum="OnFolderSelectedAsync" />
                        </div>

                        <div class="card admin-detail-card">
                            <div class="card-header d-flex align-items-center justify-content-between gap-2">
                                <h5 class="mb-0">@selectedFolder.Name</h5>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenEditDialog(selectedFolder.Id)">
                                    Edit album
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Gallery path (URL / site)</label>
                                    <div class="form-control-plaintext admin-path-display">@selectedFolder.Path</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Physical path (disk)</label>
                                    <div class="form-control-plaintext admin-path-display text-break">@physicalPath</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Visibility</label>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" @bind="selectedFolder.IsVisible" @bind:event="onchange" />
                                        <label class="form-check-label">Visible in gallery</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" rows="3" @bind="selectedFolder.Description" @bind:event="onchange"></textarea>
                                </div>

                                <button class="btn btn-primary mb-4" @onclick="SaveFolder" disabled="@isSaving">@(isSaving ? "Saving…" : "Save folder")</button>
                                @if (!string.IsNullOrEmpty(saveMessage))
                                {
                                    <div class="alert @(saveMessage.Contains("Error") ? "alert-danger" : "alert-success") mb-4">@saveMessage</div>
                                }

                                <hr />
                                <h6>Folder cover images (1–4)</h6>
                                <p class="text-muted small">Photos from this folder and subfolders. Click to toggle covers. Order follows selection order (up to 4).</p>

                                @if (coverPhotos.Any())
                                {
                                    <div class="admin-cover-preview row g-2 mb-3">
                                        @foreach (var cover in coverPhotos)
                                        {
                                            <div class="col-3">
                                                <img src="/api/images/thumbnail/@cover.Id?size=200" class="img-fluid rounded border border-warning" alt="Cover" />
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="mb-3">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearCovers" disabled="@isSavingCovers">Clear covers</button>
                                    <button class="btn btn-primary btn-sm ms-2" @onclick="SaveCovers" disabled="@isSavingCovers">@(isSavingCovers ? "Saving…" : "Save covers")</button>
                                </div>
                                @if (!string.IsNullOrEmpty(coverMessage))
                                {
                                    <div class="alert @(coverMessage.Contains("Error") ? "alert-danger" : "alert-success") mb-3">@coverMessage</div>
                                }

                                @if (isLoadingCoverPicker)
                                {
                                    <p class="text-muted small">Loading cover picker photos…</p>
                                }
                                else if (coverPickerPhotos.Any())
                                {
                                    <div class="row mb-3">
                                        @foreach (var photo in coverPickerPhotos)
                                        {
                                            var isCover = selectedCoverPhotoIds.Contains(photo.Id);
                                            <div class="col-md-3 col-sm-4 col-6 mb-3">
                                                <div class="card admin-photo-card @(isCover ? "cover-selected" : "")" @onclick="() => ToggleCoverSelection(photo.Id)">
                                                    <img src="/api/images/thumbnail/@photo.Id?size=200" class="card-img-top" alt="@photo.Filename" />
                                                    <div class="card-body p-2">
                                                        @if (isCover)
                                                        {
                                                            <span class="badge bg-warning text-dark">Cover</span>
                                                        }
                                                        @if (photo.FolderId != selectedFolderId && photo.Folder != null)
                                                        {
                                                            <small class="text-muted d-block">@photo.Folder.Name</small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-3">No photos in this folder or subfolders.</p>
                                }

                                <hr />
                                <h6>Upload photos</h6>
                                <InputFile class="form-control" multiple OnChange="HandleFileSelection" accept="image/*" />
                                <button class="btn btn-primary mt-2" @onclick="UploadPhotos" disabled="@isUploading">@(isUploading ? "Uploading…" : "Upload to this folder")</button>
                                @if (!string.IsNullOrEmpty(uploadMessage))
                                {
                                    <div class="alert @(uploadMessage.Contains("Error") ? "alert-danger" : "alert-success") mt-2">@uploadMessage</div>
                                }

                                <hr />
                                <h6>Photos in folder (@photoTotalCount)</h6>
                                @if (isLoadingPhotos)
                                {
                                    <p class="text-muted small">Loading photos…</p>
                                }
                                else
                                {
                                    <div class="row">
                                        @foreach (var photo in folderPhotos)
                                        {
                                            <div class="col-md-3 col-sm-4 col-6 mb-3">
                                                <div class="card admin-photo-card">
                                                    <img src="/api/images/thumbnail/@photo.Id?size=200" class="card-img-top" alt="@photo.Filename" />
                                                    <div class="card-body p-2">
                                                        <div class="form-check form-switch mb-1" @onclick:stopPropagation="true">
                                                            <input class="form-check-input" type="checkbox" checked="@photo.IsVisible" @onchange="(e) => TogglePhotoVisibility(photo.Id, e.Value)" />
                                                            <label class="form-check-label small">Visible</label>
                                                        </div>
                                                        <div @onclick:stopPropagation="true">
                                                            <input type="text" class="form-control form-control-sm mb-1" placeholder="Display name" value="@photo.DisplayName" @onchange="(e) => UpdatePhotoDisplayName(photo.Id, e.Value?.ToString())" />
                                                            <textarea class="form-control form-control-sm" rows="2" placeholder="Description" @onchange="(e) => UpdatePhotoDescription(photo.Id, e.Value?.ToString())">@photo.Description</textarea>
                                                        </div>
                                                        <small class="text-muted d-block text-truncate" title="@photo.Filename">@photo.Filename</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @if (photoTotalCount > folderPhotos.Count)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="LoadMorePhotos" disabled="@isLoadingPhotos">Load more</button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (activeTab == "scanning")
        {
            <div class="tab-pane active">
                <h3>Catalog Scanning</h3>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Full Catalog Scan</h5>
                        <p class="card-text">
                            Trigger a full scan of all folders and photos. This will scan the entire gallery structure
                            and update the database with any new, changed, or missing photos.
                        </p>
                        <p class="text-muted small">
                            <strong>Note:</strong> Full scans run automatically at midnight. Use this button to trigger a scan manually.
                        </p>
                        <button class="btn btn-primary" @onclick="TriggerFullScan" disabled="@isScanning">
                            @if (isScanning)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @(isScanning ? "Scanning…" : "Start Full Scan")
                        </button>
                        @if (!string.IsNullOrEmpty(scanMessage))
                        {
                            <div class="alert @(scanMessage.Contains("Error") ? "alert-danger" : "alert-success") mt-3">@scanMessage</div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "users")
        {
            <div class="tab-pane active">
                <h3>User management</h3>
                <p class="text-muted small">Create accounts, grant admin access, lock users, or remove accounts.</p>
                <AdminUsersPanel />
            </div>
        }
    </div>
</div>

<FolderEditDialog IsOpen="_editDialogOpen"
                  FolderId="_editingFolderId"
                  OnClose="CloseEditDialog"
                  OnSaved="HandleFolderEditSaved" />

@code {
    private string activeTab = "gallery";
    private int selectedFolderId;
    private Folder? selectedFolder;
    private string physicalPath = "";
    private List<Folder> childAlbums = new();
    private Dictionary<int, IReadOnlyList<Photo>> childThumbnails = new();
    private List<Photo> folderPhotos = new();
    private List<Photo> coverPhotos = new();
    private List<Photo> coverPickerPhotos = new();
    private List<int> selectedCoverPhotoIds = new();
    private bool coversCleared;
    private bool hadSavedCovers;
    private int photoSkip;
    private const int PhotoPageSize = 48;
    private int photoTotalCount;
    private bool isSaving;
    private bool isSavingCovers;
    private bool isUploading;
    private bool isScanning;
    private bool isLoadingPhotos;
    private bool isLoadingCoverPicker;
    private string? saveMessage;
    private string? coverMessage;
    private string? uploadMessage;
    private string? scanMessage;
    private IBrowserFile[]? selectedFiles;
    private bool _editDialogOpen;
    private int? _editingFolderId;

    private void SetActiveTab(string tab) => activeTab = tab;

    private async Task OnFolderSelectedAsync(int folderId)
    {
        selectedFolderId = folderId;
        saveMessage = null;
        coverMessage = null;
        uploadMessage = null;
        coversCleared = false;
        photoSkip = 0;
        folderPhotos.Clear();
        coverPickerPhotos.Clear();
        childAlbums.Clear();
        childThumbnails.Clear();

        if (folderId <= 0)
        {
            selectedFolder = null;
            physicalPath = "";
            return;
        }

        try
        {
            selectedFolder = await FolderService.GetFolderByIdAsync(folderId);
            if (selectedFolder == null)
            {
                physicalPath = "";
                return;
            }

            physicalPath = PathService.GetFullPath(selectedFolder.Path);
            coverPhotos = (await FolderService.GetFolderCoverPhotosAsync(folderId)).ToList();
            selectedCoverPhotoIds = coverPhotos.Select(p => p.Id).ToList();
            hadSavedCovers = coverPhotos.Count > 0;
            coversCleared = false;
            await ReloadChildAlbumsAsync();
            await LoadCoverPickerPhotosAsync();
            await LoadPhotosPageAsync(reset: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading folder {FolderId}", folderId);
        }
    }

    private async Task ReloadChildAlbumsAsync()
    {
        if (selectedFolderId <= 0)
        {
            childAlbums = new();
            childThumbnails = new();
            return;
        }

        try
        {
            childAlbums = await FolderService.GetChildFoldersAsync(selectedFolderId, includeHidden: true) ?? new();
            childThumbnails = new Dictionary<int, IReadOnlyList<Photo>>();
            foreach (var folder in childAlbums)
            {
                try
                {
                    childThumbnails[folder.Id] = await FolderService.GetFolderThumbnailPhotosAsync(folder.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load thumbnail for child folder {FolderId}", folder.Id);
                    childThumbnails[folder.Id] = Array.Empty<Photo>();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading child albums for folder {FolderId}", selectedFolderId);
            childAlbums = new();
            childThumbnails = new();
        }
    }

    private void OpenEditDialog(int folderId)
    {
        _editingFolderId = folderId;
        _editDialogOpen = true;
    }

    private Task CloseEditDialog()
    {
        _editDialogOpen = false;
        _editingFolderId = null;
        return Task.CompletedTask;
    }

    private async Task HandleFolderEditSaved()
    {
        if (selectedFolderId > 0)
        {
            await OnFolderSelectedAsync(selectedFolderId);
        }
    }

    private async Task LoadCoverPickerPhotosAsync()
    {
        if (selectedFolderId <= 0)
        {
            return;
        }

        isLoadingCoverPicker = true;
        try
        {
            coverPickerPhotos = (await FolderService.GetPhotosForCoverPickerAsync(selectedFolderId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cover picker photos for folder {FolderId}", selectedFolderId);
            coverPickerPhotos.Clear();
        }
        finally
        {
            isLoadingCoverPicker = false;
        }
    }

    private async Task LoadPhotosPageAsync(bool reset)
    {
        if (selectedFolderId <= 0)
        {
            return;
        }

        isLoadingPhotos = true;
        try
        {
            if (reset)
            {
                photoSkip = 0;
                folderPhotos.Clear();
            }

            photoTotalCount = await PhotoService.GetPhotoCountByFolderIdAsync(selectedFolderId, includeHidden: true);
            var page = await PhotoService.GetPhotosByFolderIdAsync(
                selectedFolderId,
                skip: photoSkip,
                take: PhotoPageSize,
                includeHidden: true);

            folderPhotos.AddRange(page);
            photoSkip += page.Count;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading photos for folder {FolderId}", selectedFolderId);
        }
        finally
        {
            isLoadingPhotos = false;
        }
    }

    private async Task LoadMorePhotos() => await LoadPhotosPageAsync(reset: false);

    private async Task SaveFolder()
    {
        if (selectedFolder == null)
        {
            return;
        }

        isSaving = true;
        saveMessage = null;
        try
        {
            await FolderService.UpdateFolderVisibilityAsync(selectedFolder.Id, selectedFolder.IsVisible);
            await FolderService.UpdateFolderDescriptionAsync(selectedFolder.Id, selectedFolder.Description);
            saveMessage = "Folder updated successfully.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving folder");
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ToggleCoverSelection(int photoId)
    {
        coversCleared = false;
        if (selectedCoverPhotoIds.Contains(photoId))
        {
            selectedCoverPhotoIds.Remove(photoId);
        }
        else if (selectedCoverPhotoIds.Count < 4)
        {
            selectedCoverPhotoIds.Add(photoId);
        }
    }

    private async Task SaveCovers()
    {
        if (selectedFolder == null)
        {
            return;
        }

        isSavingCovers = true;
        coverMessage = null;
        try
        {
            if (coversCleared || (selectedCoverPhotoIds.Count == 0 && hadSavedCovers))
            {
                await FolderService.ClearFolderCoverPhotosAsync(selectedFolder.Id);
            }
            else if (selectedCoverPhotoIds.Count > 0)
            {
                await FolderService.SetFolderCoverPhotosAsync(selectedFolder.Id, selectedCoverPhotoIds);
            }

            coversCleared = false;
            coverPhotos = (await FolderService.GetFolderCoverPhotosAsync(selectedFolder.Id)).ToList();
            selectedCoverPhotoIds = coverPhotos.Select(p => p.Id).ToList();
            hadSavedCovers = coverPhotos.Count > 0;
            await LoadCoverPickerPhotosAsync();
            coverMessage = "Cover images saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving folder covers");
            coverMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSavingCovers = false;
        }
    }

    private void ClearCovers()
    {
        if (selectedFolder == null)
        {
            return;
        }

        coversCleared = true;
        selectedCoverPhotoIds.Clear();
        coverPhotos.Clear();
        coverMessage = "Cover images will use automatic thumbnails when you save.";
    }

    private void HandleFileSelection(InputFileChangeEventArgs e) =>
        selectedFiles = e.GetMultipleFiles().ToArray();

    private async Task UploadPhotos()
    {
        if (selectedFiles == null || selectedFiles.Length == 0 || selectedFolderId == 0)
        {
            uploadMessage = "Please select files and a folder.";
            return;
        }

        isUploading = true;
        uploadMessage = null;
        try
        {
            var folder = await FolderService.GetFolderByIdAsync(selectedFolderId);
            if (folder == null)
            {
                uploadMessage = "Error: Folder not found.";
                return;
            }

            var folderPath = PathService.GetFullPath(folder.Path);
            if (!Directory.Exists(folderPath))
            {
                Directory.CreateDirectory(folderPath);
            }

            var successCount = 0;
            var errorCount = 0;
            const long maxUploadBytes = 15 * 1024 * 1024;
            foreach (var file in selectedFiles)
            {
                try
                {
                    await using var stream = file.OpenReadStream(maxAllowedSize: maxUploadBytes);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    buffer.Position = 0;

                    ImageInfo? imageInfo;
                    try
                    {
                        imageInfo = Image.Identify(buffer);
                    }
                    catch (UnknownImageFormatException)
                    {
                        errorCount++;
                        continue;
                    }

                    if (imageInfo == null)
                    {
                        errorCount++;
                        continue;
                    }

                    var ext = imageInfo.Metadata.DecodedImageFormat?.FileExtensions.FirstOrDefault() ?? "jpg";
                    var safeName = $"{Guid.NewGuid():N}.{ext}";
                    var filePath = Path.Combine(folderPath, safeName);
                    buffer.Position = 0;
                    await using (var fileStream = new FileStream(filePath, FileMode.CreateNew))
                    {
                        await buffer.CopyToAsync(fileStream);
                    }

                    await PhotoService.CreateOrUpdatePhotoAsync(filePath, selectedFolderId, safeName);
                    successCount++;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error uploading file {FileName}", file.Name);
                    errorCount++;
                }
            }

            uploadMessage = $"Upload complete: {successCount} successful, {errorCount} errors.";
            await LoadPhotosPageAsync(reset: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading photos");
            uploadMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task TogglePhotoVisibility(int photoId, object? value)
    {
        if (value is bool isVisible)
        {
            try
            {
                await PhotoService.UpdatePhotoVisibilityAsync(photoId, isVisible);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error updating photo visibility");
            }
        }
    }

    private async Task UpdatePhotoDisplayName(int photoId, string? displayName)
    {
        try
        {
            await PhotoService.UpdatePhotoDisplayNameAsync(photoId, displayName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating photo display name");
        }
    }

    private async Task UpdatePhotoDescription(int photoId, string? description)
    {
        try
        {
            await PhotoService.UpdatePhotoDescriptionAsync(photoId, description);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating photo description");
        }
    }

    private async Task TriggerFullScan()
    {
        isScanning = true;
        scanMessage = null;
        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            var response = await httpClient.PostAsync("/api/admin/scan/full", null);
            scanMessage = response.IsSuccessStatusCode
                ? "Full catalog scan started successfully. Check logs for progress."
                : $"Error: {await response.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error triggering full scan");
            scanMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isScanning = false;
        }
    }
}
