@page "/"
@page "/gallery"
@page "/gallery/{FolderId:int}"

@using KelliPhoto.Web.Data.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ILogger<Gallery> Logger
@inject IFolderService FolderService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Gallery - Kelli Thompson Photography</PageTitle>

<div class="gallery-page">
    <FolderBrowser FolderId="DisplayFolderId"
                   IsAdmin="isAdmin"
                   OnFoldersChanged="HandleFoldersChanged" />

    @if (DisplayFolderId.HasValue)
    {
        <PhotoGrid FolderId="DisplayFolderId.Value" />
    }
</div>

@code {
    [Parameter] public int? FolderId { get; set; }

    private int? DisplayFolderId { get; set; }
    private int? _lastProcessedFolderId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");

        Logger.LogInformation("Gallery.OnInitialized: FolderId={FolderId}", FolderId);
        await LoadDisplayFolderAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastProcessedFolderId == FolderId)
        {
            Logger.LogDebug("Gallery.OnParametersSet: FolderId unchanged ({FolderId}), skipping reload", FolderId);
            return;
        }

        Logger.LogInformation("Gallery.OnParametersSet: FolderId changed from {OldFolderId} to {NewFolderId}",
            _lastProcessedFolderId, FolderId);
        await LoadDisplayFolderAsync();
    }

    private async Task LoadDisplayFolderAsync()
    {
        _lastProcessedFolderId = FolderId;

        if (FolderId.HasValue)
        {
            DisplayFolderId = FolderId;
        }
        else
        {
            var homePageHighlights = await FolderService.GetFolderByNameAsync("Home Page Highlights");
            DisplayFolderId = homePageHighlights?.Id;
        }
    }

    private Task HandleFoldersChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
