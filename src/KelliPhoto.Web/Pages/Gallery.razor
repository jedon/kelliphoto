@page "/"
@page "/gallery"
@page "/gallery/{FolderId:int}"

@using KelliPhoto.Web.Data.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ILogger<Gallery> Logger
@inject IFolderService FolderService
@inject IPhotoService PhotoService
@inject AuthenticationStateProvider AuthStateProvider
@inject IHomePageCache HomePageCache

<PageTitle>Gallery - Kelli Thompson Photography</PageTitle>

<div class="gallery-page">
    <FolderBrowser FolderId="DisplayFolderId"
                   IsAdmin="isAdmin"
                   OnFoldersChanged="HandleFoldersChanged" />

    @if (DisplayFolderId.HasValue)
    {
        <div class="gallery-toolbar mb-3 d-flex justify-content-end">
            <button type="button" 
                    class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" 
                    @onclick="() => isSlideshowOpen = true" 
                    disabled="@(photoCount == 0)"
                    title="Start Slideshow">
                <i class="bi bi-play-fill fs-5"></i> Slideshow
            </button>
        </div>

        <PhotoGrid FolderId="DisplayFolderId.Value"
                   UseHomePageCache="@(!FolderId.HasValue)"
                   IsAdmin="isAdmin" />

        @if (isSlideshowOpen)
        {
            <SlideshowOverlay FolderId="DisplayFolderId.Value" OnClose="() => isSlideshowOpen = false" />
        }
    }
</div>

@code {
    [Parameter] public int? FolderId { get; set; }

    private int? DisplayFolderId { get; set; }
    private int? _lastProcessedFolderId;
    private bool isAdmin;
    private bool isSlideshowOpen = false;
    private int photoCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");

        Logger.LogInformation("Gallery.OnInitialized: FolderId={FolderId}", FolderId);
        await LoadDisplayFolderAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastProcessedFolderId == FolderId)
        {
            Logger.LogDebug("Gallery.OnParametersSet: FolderId unchanged ({FolderId}), skipping reload", FolderId);
            return;
        }

        Logger.LogInformation("Gallery.OnParametersSet: FolderId changed from {OldFolderId} to {NewFolderId}",
            _lastProcessedFolderId, FolderId);
        await LoadDisplayFolderAsync();
    }

    private async Task LoadDisplayFolderAsync()
    {
        isSlideshowOpen = false;
        _lastProcessedFolderId = FolderId;

        if (FolderId.HasValue)
        {
            if (!isAdmin && !await PhotoService.CanPublicViewFolderAsync(FolderId.Value))
            {
                DisplayFolderId = null;
                photoCount = 0;
                return;
            }

            DisplayFolderId = FolderId;
        }
        else
        {
            var homePageHighlights = await HomePageCache.GetHighlightsFolderAsync(() => FolderService.GetFolderByNameAsync("Home Page Highlights"));
            DisplayFolderId = homePageHighlights?.Id;
        }

        if (DisplayFolderId.HasValue)
        {
            photoCount = await PhotoService.GetPhotoCountByFolderIdAsync(DisplayFolderId.Value, includeHidden: isAdmin);
        }
        else
        {
            photoCount = 0;
        }
    }

    private async Task HandleFoldersChanged()
    {
        if (DisplayFolderId.HasValue)
        {
            photoCount = await PhotoService.GetPhotoCountByFolderIdAsync(DisplayFolderId.Value, includeHidden: isAdmin);
        }
        StateHasChanged();
    }
}
