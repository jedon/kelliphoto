# Copy to .env in this folder (or next to the published DLL). .env is gitignored.
# ASP.NET Core nested keys use double underscores:

# PostgreSQL (RDS, Docker service name "postgres", etc.)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=kelli_photo;Username=;Password=;SSL Mode=Prefer;Timeout=30;Command Timeout=30;Pooling=true;MinPoolSize=0;MaxPoolSize=100

Email__SmtpPassword=

# --- GitHub Actions (repository secrets) ---
# Do not commit real values. In the repo: Settings → Secrets and variables → Actions.
# Use these secret names; .github/workflows/dotnet-ci.yml maps them to the env vars above.
#
#   CONNECTION_STRINGS__DEFAULT_CONNECTION   (full connection string; same value as in .env)
#   EMAIL__SMTP_PASSWORD
#
# Optional (only if you map them in a deploy workflow — do not set empty secrets in CI or they
# override appsettings): ADMIN__EMAIL, ADMIN__PASSWORD → Admin__Email / Admin__Password env.
#
# For docker compose deploy from Actions, set secret CONNECTION_STRINGS__DEFAULT_CONNECTION
# and pass it as env to the compose step; see docker/.env.example.
