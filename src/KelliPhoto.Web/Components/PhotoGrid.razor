@using KelliPhoto.Web.Data.Models
@using KelliPhoto.Web.Models
@using Microsoft.JSInterop
@inject IPhotoService PhotoService
@inject ITagService TagService
@inject IScanProgressService ScanProgressService
@inject NavigationManager Navigation
@inject ILogger<PhotoGrid> Logger
@inject IJSRuntime JSRuntime
@inject IHomePageCache HomePageCache
@implements IAsyncDisposable

<div class="photo-grid-container">
    @if (IsAdmin && Photos.Any())
    {
        <div class="photo-admin-toolbar gallery-edit-toolbar">
            <button type="button"
                    class="btn btn-sm btn-outline-light"
                    disabled="@_busy || Photos.Count == 0"
                    @onclick="SelectAllPhotos">
                Select all
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-light"
                    disabled="@_busy || _selected.Count == 0"
                    @onclick="ClearSelection">
                None
            </button>

            @if (_selected.Count > 0)
            {
                <span class="photo-admin-selection-count">@_selected.Count selected</span>
                <div class="photo-admin-toolbar-sep" aria-hidden="true"></div>

                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        disabled="@_busy"
                        title="Show selected photos"
                        @onclick="() => SetVisibilityAsync(true)">
                    <i class="bi bi-eye"></i> Show
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        disabled="@_busy"
                        title="Hide selected photos"
                        @onclick="() => SetVisibilityAsync(false)">
                    <i class="bi bi-eye-slash"></i> Hide
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        disabled="@_busy"
                        title="Add tags to selected"
                        @onclick="() => BulkTagsAsync(true)">
                    <i class="bi bi-tag"></i> Add tags
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        disabled="@_busy"
                        title="Remove tags from selected"
                        @onclick="() => BulkTagsAsync(false)">
                    <i class="bi bi-tag-fill"></i> Remove tags
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-warning"
                        disabled="@_busy || MetadataTargetPhotoId is null"
                        title="Requires exactly one selected photo"
                        @onclick="OpenMetadataDialog">
                    <i class="bi bi-info-circle"></i> Metadata
                </button>
                <button type="button"
                        class="btn btn-sm btn-link photo-admin-clear-link"
                        disabled="@_busy"
                        @onclick="ClearSelection">
                    Clear selection
                </button>
            }

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <span class="photo-admin-status @(_statusIsError ? "is-error" : "is-info")">@_statusMessage</span>
            }
        </div>
    }

    @if (Photos.Any())
    {
        <div class="photo-masonry">
            @foreach (var photo in Photos)
            {
                var isCover = IsCoverSelected(photo.Id);
                var isSelected = IsAdmin && _selected.Contains(photo.Id);
                <div class="photo-item @(EditMode ? "photo-item-edit" : "") @(isCover ? "photo-cover-selected" : "") @(isSelected ? "photo-item-selected" : "") @(!photo.IsVisible ? "photo-item-hidden" : "")"
                     @onclick="() => HandlePhotoClick(photo)">
                    @if (IsAdmin)
                    {
                        <div class="photo-admin-check" @onclick:stopPropagation="true">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@isSelected"
                                   @onchange="(e) => TogglePhotoSelected(photo.Id, e.Value)"
                                   title="Select photo"
                                   aria-label="Select @photo.Filename" />
                        </div>
                        @if (!photo.IsVisible)
                        {
                            <span class="photo-hidden-badge">Hidden</span>
                        }
                    }
                    @if (EditMode)
                    {
                        <div class="photo-edit-overlay" @onclick:stopPropagation="true">
                            <div class="form-check form-switch photo-visibility-switch">
                                <input class="form-check-input" type="checkbox" checked="@photo.IsVisible"
                                       @onchange="(e) => TogglePhotoVisibility(photo, e.Value)" />
                                <label class="form-check-label">Visible</label>
                            </div>
                            <button type="button"
                                    class="btn btn-sm photo-cover-btn @(isCover ? "active" : "")"
                                    @onclick="() => ToggleCover(photo.Id)">
                                @(isCover ? "Cover ✓" : "Cover")
                            </button>
                        </div>
                        @if (!photo.IsVisible && !IsAdmin)
                        {
                            <span class="photo-hidden-badge">Hidden</span>
                        }
                    }
                    <div class="photo-placeholder" style="@GetPlaceholderAspectStyle(photo)">
                        <img src="/api/images/thumbnail/@photo.Id?size=400" 
                             alt="@photo.Filename" 
                             loading="lazy"
                             draggable="false"
                             oncontextmenu="return false;"
                             onload="this.parentElement.classList.add('loaded'); this.parentElement.style.removeProperty('aspect-ratio');"
                             onerror="this.onerror=null; this.parentElement.classList.add('loaded','missing'); console.error('Failed to load thumbnail for photo', @photo.Id);" />
                    </div>
                </div>
            }
        </div>

        @if (HasMore)
        {
            <div class="scroll-trigger" @ref="scrollTrigger"></div>
        }
    }
    else if (isScanning)
    {
        <div class="scanning-state">
            <div class="spinner"></div>
            <p class="scanning-message">
                @if (scanProgress != null)
                {
                    <text>Scanning: @scanProgress.ProcessedPhotos / @scanProgress.TotalPhotos photos (@((int)scanProgress.PercentComplete)%)</text>
                }
                else
                {
                    <text>Scanning folder...</text>
                }
            </p>
        </div>
    }
    else if (isLoading || !hasLoadedOnce)
    {
        <div class="loading-state">
            <div class="spinner"></div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                <strong>Error:</strong> @errorMessage
            </div>
        }
    }
</div>

@if (IsAdmin)
{
    <PhotoMetadataDialog IsOpen="_metadataDialogOpen"
                         PhotoId="_metadataPhotoId"
                         OnClose="CloseMetadataDialog"
                         OnSaved="HandleMetadataSaved" />
}

@code {
    [Parameter] public int FolderId { get; set; }
    [Parameter] public bool UseHomePageCache { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public IReadOnlyList<int> SelectedCoverPhotoIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback<int> OnPhotoCoverToggle { get; set; }

    private List<Photo> Photos { get; set; } = new();
    private int currentPage = 0;
    private const int PageSize = 50;
    private bool HasMore { get; set; } = true;
    private bool isLoading = false;
    private bool hasLoadedOnce = false; // Track if we've completed at least one load attempt
    private bool isScanning = false;
    private string? errorMessage = null;
    private ScanProgressInfo? scanProgress = null;
    private System.Threading.Timer? _progressTimer;
    private System.Threading.Timer? _refreshTimer;
    private int? _lastLoadedFolderId;
    private bool _lastEditMode;
    private bool _lastIsAdmin;
    private ElementReference scrollTrigger;
    private Microsoft.JSInterop.IJSObjectReference? _jsModule;
    private DotNetObjectReference<PhotoGrid>? _objRef;

    private readonly HashSet<int> _selected = new();
    private bool _busy;
    private string? _statusMessage;
    private bool _statusIsError;
    private bool _metadataDialogOpen;
    private int? _metadataPhotoId;
    private int? _focusedPhotoId;

    private bool IncludeHidden => EditMode || IsAdmin;

    private int? MetadataTargetPhotoId =>
        _selected.Count == 1
            ? _selected.First()
            : _focusedPhotoId is int focused && Photos.Any(p => p.Id == focused)
                ? focused
                : null;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("PhotoGrid.OnInitializedAsync: FolderId={FolderId}", FolderId);
        _lastLoadedFolderId = FolderId;
        _lastEditMode = EditMode;
        _lastIsAdmin = IsAdmin;
        // Clear photos list to prevent duplicates from previous state
        Photos = new();
        currentPage = 0;
        HasMore = true;
        hasLoadedOnce = false; // Reset load state for new folder
        
        // Load photos immediately without waiting for scan check
        await LoadPhotosAsync();
        await CheckScanStatusAsync();
        StateHasChanged(); // Render immediately with photos
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        // JS interop is invalid during static prerender (ServerPrerendered first pass); only runs after circuit attaches.
        if (HasMore && Photos.Any())
            await TryInitializeScrollObserverAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var folderChanged = _lastLoadedFolderId != FolderId;
        var editModeChanged = _lastEditMode != EditMode;
        var isAdminChanged = _lastIsAdmin != IsAdmin;

        if (!folderChanged && !editModeChanged && !isAdminChanged)
        {
            Logger.LogDebug("PhotoGrid.OnParametersSetAsync: FolderId unchanged ({FolderId}), skipping reload", FolderId);
            return;
        }

        Logger.LogInformation("PhotoGrid.OnParametersSetAsync: FolderId changed from {OldFolderId} to {NewFolderId}, EditMode={EditMode}, IsAdmin={IsAdmin}",
            _lastLoadedFolderId, FolderId, EditMode, IsAdmin);

        _lastLoadedFolderId = FolderId;
        _lastEditMode = EditMode;
        _lastIsAdmin = IsAdmin;
        Photos = new();
        currentPage = 0;
        HasMore = true;
        errorMessage = null;
        scanProgress = null;
        isScanning = false;
        hasLoadedOnce = false; // Reset load state for new folder
        _selected.Clear();
        _focusedPhotoId = null;
        ClearStatus();
        
        // Stop previous timers
        _progressTimer?.Dispose();
        _refreshTimer?.Dispose();
        
        // Load photos immediately without waiting for scan check
        await LoadPhotosAsync();
        await CheckScanStatusAsync();
        StateHasChanged(); // Render immediately with photos
    }

    private async Task LoadPhotosAsync()
    {
        if (isLoading)
        {
            Logger.LogWarning("LoadPhotosAsync called while already loading for FolderId={FolderId}", FolderId);
            return;
        }

        Logger.LogInformation("PhotoGrid.LoadPhotosAsync: Starting load for FolderId={FolderId}, Page={Page}, PageSize={PageSize}", 
            FolderId, currentPage, PageSize);

        isLoading = true;
        errorMessage = null;
        try
        {
            List<Photo> photos;
            if (UseHomePageCache && currentPage == 0)
            {
                photos = await HomePageCache.GetFirstPagePhotosAsync(FolderId, PageSize, IncludeHidden, 
                    () => PhotoService.GetPhotosByFolderIdAsync(FolderId, 0, PageSize, includeHidden: IncludeHidden));
            }
            else
            {
                photos = await PhotoService.GetPhotosByFolderIdAsync(FolderId, currentPage * PageSize, PageSize, includeHidden: IncludeHidden);
            }
            
            Logger.LogInformation("PhotoGrid.LoadPhotosAsync: Received {Count} photos from service for FolderId={FolderId}", 
                photos?.Count ?? 0, FolderId);
            
            if (photos == null)
            {
                Logger.LogWarning("PhotoGrid.LoadPhotosAsync: PhotoService returned null for FolderId={FolderId}", FolderId);
                photos = new List<Photo>();
            }
            
            if (photos.Count < PageSize)
            {
                HasMore = false;
                Logger.LogInformation("PhotoGrid.LoadPhotosAsync: No more photos available (returned {Count} < {PageSize})", 
                    photos.Count, PageSize);
            }

            // Use DistinctBy to prevent duplicates - more efficient than checking each one
            var uniquePhotos = photos.DistinctBy(p => p.Id).Where(p => !Photos.Any(existing => existing.Id == p.Id)).ToList();
            Photos.AddRange(uniquePhotos);
            currentPage++;
            
            Logger.LogDebug("Added {NewCount} unique photos (filtered {FilteredCount} duplicates)", uniquePhotos.Count, photos.Count - uniquePhotos.Count);
            
            Logger.LogInformation("PhotoGrid.LoadPhotosAsync: Successfully loaded. Total photos in grid: {TotalCount}, Current page: {Page}", 
                Photos.Count, currentPage);
            
            if (photos.Count > 0)
            {
                Logger.LogInformation("PhotoGrid.LoadPhotosAsync: First photo in batch - Id={Id}, Filename={Filename}", 
                    photos[0].Id, photos[0].Filename);
            }
            
            // Next OnAfterRenderAsync will attach/update the scroll observer when HasMore && Photos.Any()
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Log error but don't crash - just show empty state
            errorMessage = $"Error loading photos: {ex.Message}";
            Logger.LogError(ex, "PhotoGrid.LoadPhotosAsync: Error loading photos for FolderId={FolderId}: {Message}", 
                FolderId, ex.Message);
            HasMore = false;
        }
        finally
        {
            isLoading = false;
            hasLoadedOnce = true; // Mark that we've completed at least one load attempt
            Logger.LogInformation("PhotoGrid.LoadPhotosAsync: Completed for FolderId={FolderId}, Final count: {Count}", 
                FolderId, Photos.Count);
        }
    }

    private async Task TryInitializeScrollObserverAsync()
    {
        if (!HasMore)
            return;

        try
        {
            if (_jsModule != null)
            {
                try
                {
                    await _jsModule.InvokeVoidAsync("disposeScrollObserver");
                }
                catch
                {
                    // ignore
                }
            }

            _objRef?.Dispose();
            _objRef = DotNetObjectReference.Create(this);

            if (_jsModule == null)
                _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/photoGrid.js");

            await Task.Delay(50);
            await _jsModule.InvokeVoidAsync("initializeScrollObserver", scrollTrigger, _objRef);
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("JavaScript interop", StringComparison.OrdinalIgnoreCase)
                                                  || ex.Message.Contains("statically rendered", StringComparison.OrdinalIgnoreCase)
                                                  || ex.Message.Contains("prerender", StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogDebug(ex, "Scroll observer skipped until interactive render");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing scroll observer");
        }
    }

    [JSInvokable]
    public async Task LoadMoreOnScroll()
    {
        if (HasMore && !isLoading)
        {
            await LoadPhotosAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandlePhotoClick(Photo photo)
    {
        if (IsAdmin)
            _focusedPhotoId = photo.Id;

        if (EditMode)
        {
            _ = ToggleCover(photo.Id);
        }
        else
        {
            Navigation.NavigateTo($"/photo/{photo.Id}");
        }
    }

    private void TogglePhotoSelected(int photoId, object? value)
    {
        var selected = value is bool b && b;
        if (selected)
        {
            _selected.Add(photoId);
            _focusedPhotoId = photoId;
        }
        else
        {
            _selected.Remove(photoId);
        }
        ClearStatus();
    }

    private void SelectAllPhotos()
    {
        foreach (var photo in Photos)
            _selected.Add(photo.Id);
        ClearStatus();
    }

    private void ClearSelection()
    {
        _selected.Clear();
        ClearStatus();
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }

    private void SetStatus(string message, bool error = false)
    {
        _statusMessage = message;
        _statusIsError = error;
    }

    private async Task SetVisibilityAsync(bool isVisible)
    {
        if (_busy || _selected.Count == 0)
            return;

        var ids = _selected.ToList();
        _busy = true;
        ClearStatus();
        try
        {
            await PhotoService.SetPhotosVisibilityAsync(ids, isVisible);
            foreach (var photo in Photos.Where(p => ids.Contains(p.Id)))
                photo.IsVisible = isVisible;
            SetStatus(isVisible ? $"Showed {ids.Count} photo(s)." : $"Hid {ids.Count} photo(s).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SetPhotosVisibilityAsync failed");
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BulkTagsAsync(bool attach)
    {
        if (_busy || _selected.Count == 0)
            return;

        string? raw;
        try
        {
            raw = await JSRuntime.InvokeAsync<string?>(
                "prompt",
                attach
                    ? "Tag name(s) to add (comma-separated):"
                    : "Tag name(s) to remove (comma-separated):");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Tag prompt failed");
            SetStatus("Could not open tag prompt.", error: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(raw))
            return;

        var tagNames = raw
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(t => t.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (tagNames.Count == 0)
            return;

        var ids = _selected.ToList();
        _busy = true;
        ClearStatus();
        try
        {
            if (attach)
                await TagService.BulkAttachToPhotosAsync(ids, tagNames);
            else
                await TagService.BulkDetachFromPhotosAsync(ids, tagNames);

            SetStatus(attach
                ? $"Added tag(s) to {ids.Count} photo(s)."
                : $"Removed tag(s) from {ids.Count} photo(s).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk photo tag {Action} failed", attach ? "attach" : "detach");
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenMetadataDialog()
    {
        var target = MetadataTargetPhotoId;
        if (target is null)
            return;

        _metadataPhotoId = target;
        _metadataDialogOpen = true;
    }

    private void CloseMetadataDialog()
    {
        _metadataDialogOpen = false;
        _metadataPhotoId = null;
    }

    private Task HandleMetadataSaved()
    {
        SetStatus("Photo metadata saved.");
        return Task.CompletedTask;
    }

    private bool IsCoverSelected(int photoId) =>
        SelectedCoverPhotoIds.Contains(photoId);

    private async Task ToggleCover(int photoId)
    {
        if (OnPhotoCoverToggle.HasDelegate)
        {
            await OnPhotoCoverToggle.InvokeAsync(photoId);
        }
    }

    private async Task TogglePhotoVisibility(Photo photo, object? value)
    {
        if (value is bool isVisible)
        {
            photo.IsVisible = isVisible;
            try
            {
                await PhotoService.UpdatePhotoVisibilityAsync(photo.Id, isVisible);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error updating photo visibility for {PhotoId}", photo.Id);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Inline aspect-ratio when DB has dimensions so masonry stays stable for broken thumbnails.</summary>
    private static string? GetPlaceholderAspectStyle(Photo photo)
    {
        if (photo.Width is > 0 && photo.Height is > 0)
            return $"aspect-ratio: {photo.Width} / {photo.Height};";
        return null;
    }

    private async Task CheckScanStatusAsync()
    {
        try
        {
            var p = ScanProgressService.GetProgress(FolderId);
            if (p == null)
            {
                isScanning = false;
                scanProgress = null;
                _progressTimer?.Dispose();
                _refreshTimer?.Dispose();
            }
            else
            {
                scanProgress = new ScanProgressInfo
                {
                    FolderId = p.FolderId,
                    TotalPhotos = p.TotalPhotos,
                    ProcessedPhotos = p.ProcessedPhotos,
                    PercentComplete = p.PercentComplete,
                    IsComplete = p.IsComplete,
                    ElapsedSeconds = p.Elapsed.TotalSeconds
                };
                isScanning = !p.IsComplete;

                if (isScanning)
                {
                    _progressTimer?.Dispose();
                    _progressTimer = new System.Threading.Timer(_ =>
                    {
                        _ = InvokeAsync(async () => await CheckScanStatusAsync());
                    }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));

                    _refreshTimer?.Dispose();
                    _refreshTimer = new System.Threading.Timer(_ =>
                    {
                        _ = InvokeAsync(async () => await RefreshPhotosAsync());
                    }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
                }
                else if (p.IsComplete)
                {
                    await RefreshPhotosAsync();
                    _progressTimer?.Dispose();
                    _refreshTimer?.Dispose();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Error checking scan status for folder {FolderId} (non-critical)", FolderId);
            isScanning = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshPhotosAsync()
    {
        try
        {
            var previousCount = Photos.Count;
            List<Photo> photos = await PhotoService.GetPhotosByFolderIdAsync(FolderId, 0, PageSize, includeHidden: IncludeHidden);
            
            if (photos != null && photos.Count > previousCount)
            {
                // Merge new photos instead of replacing - prevent duplicates
                var newPhotos = photos.Where(p => !Photos.Any(existing => existing.Id == p.Id)).ToList();
                if (newPhotos.Any())
                {
                    Photos.InsertRange(0, newPhotos);
                    currentPage = (int)Math.Ceiling((double)Photos.Count / PageSize);
                    HasMore = photos.Count >= PageSize || Photos.Count > photos.Count;
                    await InvokeAsync(StateHasChanged);
                    Logger.LogInformation("Refreshed photos: Added {NewCount} new photos (total now {TotalCount}, was {PreviousCount})", newPhotos.Count, Photos.Count, previousCount);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing photos for folder {FolderId}", FolderId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _progressTimer?.Dispose();
        _refreshTimer?.Dispose();
        
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("disposeScrollObserver");
                await _jsModule.DisposeAsync();
            }
            catch (InvalidOperationException)
            {
                // Component may be disposing during prerender/shutdown
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error disposing scroll observer");
            }
        }
        
        _objRef?.Dispose();
    }
}
