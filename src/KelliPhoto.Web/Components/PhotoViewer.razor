@using KelliPhoto.Web.Data.Models
@using KelliPhoto.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IPhotoService PhotoService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@if (_notFound)
{
    <div class="text-center text-muted py-5">
        <p>Photo not found.</p>
        <button class="btn btn-secondary" @onclick="GoToGallery">
            <i class="bi bi-arrow-left"></i> Back to Gallery
        </button>
    </div>
}
else if (Photo != null)
{
    <div class="photo-viewer" @onkeydown="HandleKeyDown" tabindex="0" @ref="_viewerDiv" style="outline: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back
            </button>
            <div class="text-center">
                <h4 class="mb-0">@Photo.Filename</h4>
                @if (_adjacentPhotos != null)
                {
                    <small class="text-muted">@_adjacentPhotos.Index of @_adjacentPhotos.Total</small>
                }
            </div>
            <div style="width: 72px;"></div>
        </div>

        <div class="row align-items-center g-3">
            <div class="col-auto">
                <button class="btn btn-outline-secondary" 
                        @onclick="NavigateToPrev" 
                        disabled="@(_adjacentPhotos?.PrevId == null)"
                        title="Previous (Left Arrow)">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>
            
            <div class="col text-center">
                <img src="/api/images/web/@Photo.Id?max=2000&watermark=true" 
                     alt="@Photo.Filename" 
                     class="img-fluid protected-image"
                     style="max-height: 80vh; max-width: 100%;"
                     draggable="false"
                     oncontextmenu="return false;" />
            </div>

            <div class="col-auto">
                <button class="btn btn-outline-secondary" 
                        @onclick="NavigateToNext" 
                        disabled="@(_adjacentPhotos?.NextId == null)"
                        title="Next (Right Arrow)">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

        @if (Photo.Width.HasValue && Photo.Height.HasValue)
        {
            <div class="mt-3 text-center text-muted">
                <small>@Photo.Width x @Photo.Height pixels</small>
                @if (Photo.TakenAt.HasValue)
                {
                    <small> | Taken: @Photo.TakenAt.Value.ToString("yyyy-MM-dd HH:mm")</small>
                }
            </div>
        }
    </div>
}
else
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    [Parameter] public int PhotoId { get; set; }

    private Photo? Photo { get; set; }
    private AdjacentPhotos? _adjacentPhotos;
    private bool _notFound;
    private ElementReference _viewerDiv;

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPhotoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Photo != null)
        {
            try
            {
                await _viewerDiv.FocusAsync();
            }
            catch
            {
                // Ignore focus errors
            }
        }
    }

    private async Task LoadPhotoAsync()
    {
        _notFound = false;
        Photo = null;
        _adjacentPhotos = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var isAdmin = authState.User.IsInRole(RoleNames.Admin);

        if (!isAdmin && !await PhotoService.CanPublicViewPhotoAsync(PhotoId))
        {
            _notFound = true;
            return;
        }

        Photo = await PhotoService.GetPhotoByIdAsync(PhotoId);
        if (Photo == null)
        {
            _notFound = true;
            return;
        }

        _adjacentPhotos = await PhotoService.GetAdjacentPhotoIdsAsync(PhotoId, includeHidden: isAdmin);
    }

    private void NavigateToPrev()
    {
        if (_adjacentPhotos?.PrevId != null)
        {
            NavigateToPhoto(_adjacentPhotos.PrevId.Value);
        }
    }

    private void NavigateToNext()
    {
        if (_adjacentPhotos?.NextId != null)
        {
            NavigateToPhoto(_adjacentPhotos.NextId.Value);
        }
    }

    private void NavigateToPhoto(int id)
    {
        Navigation.NavigateTo($"/photo/{id}");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft" && _adjacentPhotos?.PrevId != null)
        {
            NavigateToPrev();
        }
        else if (e.Key == "ArrowRight" && _adjacentPhotos?.NextId != null)
        {
            NavigateToNext();
        }
        else if (e.Key == "Escape")
        {
            GoBack();
        }
    }

    private void GoBack()
    {
        if (Photo?.FolderId != null)
        {
            Navigation.NavigateTo($"/gallery/{Photo.FolderId}");
        }
        else
        {
            Navigation.NavigateTo("/gallery");
        }
    }

    private void GoToGallery()
    {
        Navigation.NavigateTo("/gallery");
    }
}
