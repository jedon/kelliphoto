@using KelliPhoto.Web.Data.Models
@inject IFolderService FolderService
@inject IPhotoService PhotoService
@inject IScanProgressService ProgressService
@inject NavigationManager Navigation
@inject ILogger<FolderBrowser> Logger

@{
    RenderFragment<Folder> FolderCard = folder => @<div class="card folder-card @(EditMode ? "folder-card-edit" : "") @(!folder.IsVisible ? "folder-card-hidden" : "")"
                                                      @onclick="() => NavigateToFolder(folder.Id)" style="cursor: pointer;">
        @if (EditMode)
        {
            <div class="folder-edit-overlay" @onclick:stopPropagation="true">
                <div class="form-check form-switch folder-visibility-switch">
                    <input class="form-check-input" type="checkbox" checked="@folder.IsVisible"
                           @onchange="(e) => ToggleFolderVisibility(folder, e.Value)" />
                    <label class="form-check-label">Visible</label>
                </div>
            </div>
            @if (!folder.IsVisible)
            {
                <span class="folder-hidden-badge">Hidden</span>
            }
        }
        @RenderFolderThumbnail(folder.Id, folder.Name)
        <div class="card-body text-center">
            <p class="card-text">@folder.Name</p>
        </div>
    </div>;
}

<div class="folder-browser">
    @if (CurrentFolder != null)
    {
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            @{
                // Filter out "Home Page Highlights" and "kelli.photo" from breadcrumbs
                var filteredBreadcrumbs = Breadcrumbs
                    .Where(f => f.Name.ToLower() != "home page highlights" &&
                                f.Name.ToLower() != "kelli.photo")
                    .ToList();
                
                var showCurrentFolder = CurrentFolder != null && 
                                       CurrentFolder.Name.ToLower() != "home page highlights" &&
                                       CurrentFolder.Name.ToLower() != "kelli.photo";
            }
            
            @if (filteredBreadcrumbs.Any() || showCurrentFolder)
            {
                @foreach (var folder in filteredBreadcrumbs)
                {
                    <a href="#" @onclick="() => NavigateToFolder(folder.Id)">@folder.Name</a>
                    <span class="breadcrumb-separator">/</span>
                }
                
                @if (showCurrentFolder)
                {
                    <span class="breadcrumb-current">@CurrentFolder.Name</span>
                }
            }
        </nav>

        <div class="folder-list">
            @if (ChildFolders.Any())
            {
                <h5>Folders</h5>
                <div class="row">
                    @foreach (var folder in ChildFolders)
                    {
                        <div class="col-md-3 col-sm-4 col-6 mb-3">
                            @FolderCard(folder)
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (RootFolders.Any())
    {
        <div class="folder-list">
        <h5>Gallery Folders</h5>
        <div class="row">
            @foreach (var folder in RootFolders)
            {
                <div class="col-md-3 col-sm-4 col-6 mb-3">
                    @FolderCard(folder)
                </div>
            }
        </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning" role="alert">
            <strong>Connection Error:</strong> @errorMessage
            <br />
            <small>Please check your database connection and try refreshing the page.</small>
        </div>
    }
    else if (!isLoading && !FolderId.HasValue)
    {
        <p class="empty-state">No folders found.</p>
    }
</div>

@code {
    [Parameter] public int? FolderId { get; set; }
    [Parameter] public bool EditMode { get; set; }

    private List<Folder> RootFolders { get; set; } = new();
    private List<Folder> ChildFolders { get; set; } = new();
    private Folder? CurrentFolder { get; set; }
    private List<Folder> Breadcrumbs { get; set; } = new();
    private Dictionary<int, IReadOnlyList<Photo>> FolderThumbnails { get; set; } = new();
    private bool isLoading = false;
    private string? errorMessage = null;

    private int? _lastLoadedFolderId;
    private bool _lastEditMode;

    protected override async Task OnInitializedAsync()
    {
        _lastLoadedFolderId = FolderId;
        _lastEditMode = EditMode;
        await LoadFoldersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var folderChanged = _lastLoadedFolderId != FolderId;
        var editModeChanged = _lastEditMode != EditMode;

        if (!folderChanged && !editModeChanged)
        {
            Logger.LogDebug("FolderBrowser.OnParametersSet: FolderId unchanged ({FolderId}), skipping reload", FolderId);
            return;
        }

        Logger.LogInformation("FolderBrowser.OnParametersSet: FolderId changed from {OldFolderId} to {NewFolderId}, EditMode={EditMode}",
            _lastLoadedFolderId, FolderId, EditMode);
        _lastLoadedFolderId = FolderId;
        _lastEditMode = EditMode;
        await LoadFoldersAsync();
    }

    private async Task LoadFoldersAsync()
    {
        if (isLoading) return;
        
        isLoading = true;
        errorMessage = null;
        
        try
        {
            if (FolderId.HasValue)
            {
                // Load sequentially to avoid DbContext concurrency issues
                CurrentFolder = await FolderService.GetFolderByIdAsync(FolderId.Value);
                if (CurrentFolder != null)
                {
                    // These are already sequential due to await
                    ChildFolders = await FolderService.GetChildFoldersAsync(FolderId.Value, includeHidden: EditMode);
                    if (ChildFolders == null)
                    {
                        ChildFolders = new();
                    }
                    // Filter out directories starting with ., Home Page Highlights, and testfolder as additional safety measure
                    ChildFolders = ChildFolders
                        .Where(f => !f.Name.StartsWith(".") &&
                                   f.Name.ToLower() != "home page highlights" &&
                                   f.Name.ToLower() != "testfolder")
                        .ToList();
                    Breadcrumbs = await BuildBreadcrumbsAsync(CurrentFolder);
                    if (Breadcrumbs == null)
                    {
                        Breadcrumbs = new();
                    }
                    
                    // Load thumbnails for child folders
                    await LoadFolderThumbnailsAsync(ChildFolders);
                }
            }
            else
            {
                // Use GetTopLevelFoldersAsync to skip the kelli.photo root folder
                RootFolders = await FolderService.GetTopLevelFoldersAsync(includeHidden: EditMode);
                Logger.LogInformation("FolderBrowser: Loaded {Count} root folders from database", RootFolders?.Count ?? 0);
                
                if (RootFolders == null)
                {
                    RootFolders = new();
                }
                // Filter out directories starting with ., Home Page Highlights, and testfolder as additional safety measure
                var beforeFilter = RootFolders.Count;
                RootFolders = RootFolders
                    .Where(f => !f.Name.StartsWith(".") &&
                               f.Name.ToLower() != "home page highlights" &&
                               f.Name.ToLower() != "testfolder")
                    .ToList();
                Logger.LogInformation("FolderBrowser: After filtering, {Count} folders remain (filtered {FilteredCount})", 
                    RootFolders.Count, beforeFilter - RootFolders.Count);
                
                CurrentFolder = null;
                ChildFolders = new();
                Breadcrumbs = new();
                
                // Load thumbnails for root folders
                await LoadFolderThumbnailsAsync(RootFolders);
            }
        }
        catch (System.Net.Sockets.SocketException ex)
        {
            // Network/connection error
            Logger.LogError(ex, "Network error loading folders");
            errorMessage = "Network connection error. Please check your internet connection and database server.";
            if (RootFolders == null)
            {
                RootFolders = new();
            }
            if (ChildFolders == null)
            {
                ChildFolders = new();
            }
            if (Breadcrumbs == null)
            {
                Breadcrumbs = new();
            }
        }
        catch (System.IO.IOException ex)
        {
            // I/O error (often related to database connection)
            Logger.LogError(ex, "I/O error loading folders");
            errorMessage = "Database connection error. The connection may have been interrupted.";
            if (RootFolders == null)
            {
                RootFolders = new();
            }
            if (ChildFolders == null)
            {
                ChildFolders = new();
            }
            if (Breadcrumbs == null)
            {
                Breadcrumbs = new();
            }
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            // Database update/query error
            Logger.LogError(ex, "Database error loading folders");
            errorMessage = "Database error occurred. Please try again.";
            if (RootFolders == null)
            {
                RootFolders = new();
            }
            if (ChildFolders == null)
            {
                ChildFolders = new();
            }
            if (Breadcrumbs == null)
            {
                Breadcrumbs = new();
            }
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("context") || ex.Message.Contains("operation"))
        {
            // DbContext concurrency error
            Logger.LogError(ex, "Database concurrency error loading folders");
            errorMessage = "Database operation conflict. Please refresh the page.";
            if (RootFolders == null)
            {
                RootFolders = new();
            }
            if (ChildFolders == null)
            {
                ChildFolders = new();
            }
            if (Breadcrumbs == null)
            {
                Breadcrumbs = new();
            }
        }
        catch (Exception ex) when (ex.GetType().FullName?.Contains("Npgsql") == true)
        {
            // Database connection error
            Logger.LogError(ex, "Database connection error loading folders");
            errorMessage = "Unable to connect to the database. Please check your connection settings.";
            if (RootFolders == null)
            {
                RootFolders = new();
            }
            if (ChildFolders == null)
            {
                ChildFolders = new();
            }
            if (Breadcrumbs == null)
            {
                Breadcrumbs = new();
            }
        }
        catch (Exception ex)
        {
            // Other errors
            Logger.LogError(ex, "Error loading folders");
            errorMessage = $"An error occurred: {ex.Message}";
            if (RootFolders == null)
            {
                RootFolders = new();
            }
            if (ChildFolders == null)
            {
                ChildFolders = new();
            }
            if (Breadcrumbs == null)
            {
                Breadcrumbs = new();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<Folder>> BuildBreadcrumbsAsync(Folder folder)
    {
        // Use FolderService to get the full breadcrumb path
        // This queries the database to get the complete parent chain
        return await FolderService.GetBreadcrumbPathAsync(folder.Id);
    }

    private async Task NavigateToFolder(int folderId)
    {
        Logger.LogInformation("FolderBrowser.NavigateToFolder: User clicked folder with Id={FolderId}", folderId);
        
        try
        {
            var folder = await FolderService.GetFolderByIdAsync(folderId);
            if (folder != null)
            {
                // Quick check if folder needs scanning
                var needsScan = await PhotoService.NeedsFolderScanAsync(folderId, folder.Path);
                if (needsScan)
                {
                    Logger.LogInformation("Folder {FolderId} needs scanning, starting scan...", folderId);
                    
                    // Scan the folder in background with progress tracking
                    // Use batched method with batch size of 400 for optimal performance
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await PhotoService.ScanPhotosInFolderBatchedAsync(folderId, folder.Path, ProgressService, batchSize: 400);
                            Logger.LogInformation("Completed scan for folder {FolderId}", folderId);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, "Error scanning folder {FolderId}", folderId);
                            ProgressService.CompleteScan(folderId); // Mark as complete even on error
                        }
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking folder scan status for {FolderId}", folderId);
        }
        
        Navigation.NavigateTo($"/gallery/{folderId}");
    }

    private void NavigateToRoot()
    {
        Logger.LogInformation("FolderBrowser.NavigateToRoot: User navigated to root gallery");
        Navigation.NavigateTo("/gallery");
    }

    private async void NavigateToHome()
    {
        Logger.LogInformation("FolderBrowser.NavigateToHome: User navigated to home");
        var homePageHighlights = await FolderService.GetFolderByNameAsync("Home Page Highlights");
        if (homePageHighlights != null)
        {
            Navigation.NavigateTo($"/gallery/{homePageHighlights.Id}");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task LoadFolderThumbnailsAsync(List<Folder> folders)
    {
        FolderThumbnails.Clear();
        
        foreach (var folder in folders)
        {
            try
            {
                var thumbnails = await FolderService.GetFolderThumbnailPhotosAsync(folder.Id);
                FolderThumbnails[folder.Id] = thumbnails;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load thumbnail for folder {FolderId}", folder.Id);
                FolderThumbnails[folder.Id] = Array.Empty<Photo>();
            }
        }
    }

    private async Task ToggleFolderVisibility(Folder folder, object? value)
    {
        if (value is bool isVisible)
        {
            folder.IsVisible = isVisible;
            try
            {
                await FolderService.UpdateFolderVisibilityAsync(folder.Id, isVisible);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error updating folder visibility for {FolderId}", folder.Id);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private RenderFragment RenderFolderThumbnail(int folderId, string folderName) => builder =>
    {
        var thumbnails = FolderThumbnails.GetValueOrDefault(folderId) ?? Array.Empty<Photo>();

        if (thumbnails.Count >= 2)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "folder-thumbnail-grid");

            for (var i = 0; i < 4; i++)
            {
                builder.OpenElement(2, "div");
                builder.AddAttribute(3, "class", "folder-thumbnail-grid-cell");

                if (i < thumbnails.Count)
                {
                    var photo = thumbnails[i];
                    builder.OpenElement(4, "img");
                    builder.AddAttribute(5, "src", $"/api/images/thumbnail/{photo.Id}?size=300");
                    builder.AddAttribute(6, "alt", folderName);
                    builder.AddAttribute(7, "loading", "lazy");
                    builder.AddAttribute(8, "draggable", "false");
                    builder.AddAttribute(9, "oncontextmenu", "return false;");
                    builder.CloseElement();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
            return;
        }

        if (thumbnails.Count == 1)
        {
            var photo = thumbnails[0];
            builder.OpenElement(10, "img");
            builder.AddAttribute(11, "src", $"/api/images/thumbnail/{photo.Id}?size=300");
            builder.AddAttribute(12, "alt", folderName);
            builder.AddAttribute(13, "class", "folder-thumbnail");
            builder.AddAttribute(14, "loading", "lazy");
            builder.AddAttribute(15, "draggable", "false");
            builder.AddAttribute(16, "oncontextmenu", "return false;");
            builder.AddAttribute(17, "onerror", "this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';");
            builder.CloseElement();

            builder.OpenElement(18, "div");
            builder.AddAttribute(19, "class", "folder-icon-fallback");
            builder.AddAttribute(20, "style", "display: none;");
            builder.OpenElement(21, "i");
            builder.AddAttribute(22, "class", "bi bi-folder");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(23, "div");
        builder.AddAttribute(24, "class", "folder-icon-fallback");
        builder.OpenElement(25, "i");
        builder.AddAttribute(26, "class", "bi bi-folder");
        builder.CloseElement();
        builder.CloseElement();
    };
}
