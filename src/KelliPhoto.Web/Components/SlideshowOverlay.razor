@using KelliPhoto.Web.Models
@using KelliPhoto.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IPhotoService PhotoService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject ILogger<SlideshowOverlay> Logger
@implements IAsyncDisposable

<div class="slideshow-overlay @(IsImmersive ? "is-immersive" : "") @(_showChrome ? "show-chrome" : "")"
     @onkeydown="HandleKeyDown"
     @onmousemove="HandleMouseMove"
     tabindex="0"
     @ref="_overlayDiv"
     style="outline: none;">
    @if (!IsImmersive || _showChrome)
    {
        <button type="button" class="slideshow-close" @onclick="CloseOverlayAsync" title="Close Slideshow (Esc)">
            <i class="bi bi-x-lg"></i>
        </button>
    }

    @if (Photos == null)
    {
        <div class="slideshow-loading">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!Photos.Any())
    {
        <div class="slideshow-empty">
            <p>No photos in this folder.</p>
            <button class="btn btn-outline-light btn-sm mt-2" @onclick="CloseOverlayAsync">Close</button>
        </div>
    }
    else
    {
        var currentPhoto = Photos[CurrentIndex];
        var transitionClass = $"transition-{Settings.Transition.ToLowerInvariant()}";

        @if (!IsImmersive || _showChrome)
        {
            <div class="slideshow-counter">
                @(CurrentIndex + 1) / @Photos.Count
            </div>
        }

        <div class="slideshow-main">
            <button type="button" class="slideshow-nav-arrow slideshow-nav-left" @onclick="PrevPhotoAsync" title="Previous Photo (Left Arrow)">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="slideshow-image-wrapper">
                <div class="slideshow-stage">
                    @if (_outgoingPhotoId is int outgoingId && Settings.Transition != "None")
                    {
                        <img src="/api/images/web/@outgoingId?max=2000&watermark=true"
                             alt=""
                             class="slideshow-layer slideshow-layer--stacked slideshow-layer--exit @transitionClass protected-image"
                             draggable="false"
                             oncontextmenu="return false;"
                             aria-hidden="true" />
                    }

                    <img @key="_enterAnimKey"
                         src="/api/images/web/@currentPhoto.Id?max=2000&watermark=true"
                         alt="@currentPhoto.Filename"
                         class="slideshow-layer @(Settings.Transition != "None" && _outgoingPhotoId.HasValue ? "slideshow-layer--stacked" : "") slideshow-layer--enter @(Settings.Transition != "None" ? transitionClass : "transition-none") protected-image"
                         draggable="false"
                         oncontextmenu="return false;"
                         @onload="OnIncomingImageLoaded" />
                </div>
            </div>

            <button type="button" class="slideshow-nav-arrow slideshow-nav-right" @onclick="NextPhotoAsync" title="Next Photo (Right Arrow)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <div class="slideshow-controls">
            <button type="button" class="btn btn-link text-white p-1" @onclick="PrevPhotoAsync" title="Previous Photo (Left Arrow)">
                <i class="bi bi-skip-start-fill fs-4"></i>
            </button>

            @if (IsPlaying)
            {
                <button type="button" class="btn btn-link text-white p-1" @onclick="TogglePlay" title="Pause (Space)">
                    <i class="bi bi-pause-fill fs-3"></i>
                </button>
            }
            else
            {
                <button type="button" class="btn btn-link text-white p-1" @onclick="TogglePlay" title="Play (Space)">
                    <i class="bi bi-play-fill fs-3"></i>
                </button>
            }

            <button type="button" class="btn btn-link text-white p-1" @onclick="NextPhotoAsync" title="Next Photo (Right Arrow)">
                <i class="bi bi-skip-end-fill fs-4"></i>
            </button>

            <button type="button" class="btn btn-link text-white p-1" @onclick="ToggleFullscreenAsync" title="@(IsImmersive ? "Exit fullscreen" : "Enter fullscreen")">
                <i class="bi @(IsImmersive ? "bi-fullscreen-exit" : "bi-fullscreen") fs-5"></i>
            </button>

            <button type="button" class="btn btn-link text-white p-1 @(ShowSettings ? "active" : "")" @onclick="ToggleSettings" title="Settings">
                <i class="bi bi-gear-fill fs-4"></i>
            </button>
        </div>

        @if (ShowSettings && (!IsImmersive || _showChrome))
        {
            <div class="slideshow-settings-panel" @onclick:stopPropagation="true">
                <h5 class="h6 mb-3 text-white border-bottom border-secondary pb-2">Slideshow Settings</h5>

                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between small text-white-50">
                        <span>Seconds per image:</span>
                        <span class="text-white fw-bold">@Settings.SecondsPerImage s</span>
                    </label>
                    <input type="range" class="form-range" min="3" max="30" step="1"
                           value="@Settings.SecondsPerImage" @onchange="OnSecondsChanged" />
                </div>

                <div class="mb-3">
                    <label class="form-label small text-white-50">Transition effect:</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary"
                            value="@Settings.Transition" @onchange="OnTransitionChanged">
                        <option value="None">None</option>
                        <option value="Fade">Fade</option>
                        <option value="Slide">Slide</option>
                    </select>
                </div>

                <div class="form-check form-switch small">
                    <input class="form-check-input" type="checkbox" id="loopSwitch"
                           checked="@Settings.Loop" @onchange="OnLoopChanged" />
                    <label class="form-check-label text-white-50" for="loopSwitch">Loop playlist</label>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int FolderId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<Photo>? Photos { get; set; }
    private int CurrentIndex { get; set; }
    private bool IsPlaying { get; set; } = true;
    private bool ShowSettings { get; set; }
    private bool IsImmersive { get; set; }
    private SlideshowSettings Settings { get; set; } = new();

    private ElementReference _overlayDiv;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _displaySubscription;
    private DotNetObjectReference<SlideshowOverlay>? _dotNetRef;
    private System.Threading.Timer? _timer;
    private System.Threading.Timer? _chromeHideTimer;
    private CancellationTokenSource? _transitionCts;
    private int? _outgoingPhotoId;
    private int _enterAnimKey;
    private int _lastFocusedIndex = -1;
    private bool _disposed;
    private bool _lastShowSettings;
    private bool _showChrome;
    private DateTime _lastMouseMoveUtc = DateTime.MinValue;

    private static readonly TimeSpan FadeDuration = TimeSpan.FromMilliseconds(700);
    private static readonly TimeSpan SlideDuration = TimeSpan.FromMilliseconds(550);

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotosAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/slideshowSettings.js");
                var savedSettings = await _jsModule.InvokeAsync<SlideshowSettings>("getSettings");
                if (savedSettings != null)
                {
                    Settings = savedSettings;
                    if (IsPlaying && Photos != null && Photos.Any())
                    {
                        RestartTimer();
                    }
                }

                _dotNetRef = DotNetObjectReference.Create(this);
                _displaySubscription = await _jsModule.InvokeAsync<IJSObjectReference>("subscribeDisplayMode", _dotNetRef);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error initializing slideshow JS interop");
            }
            finally
            {
                StateHasChanged();
            }
        }

        if (Photos != null && Photos.Any() && !ShowSettings && (!IsImmersive || _showChrome))
        {
            var settingsClosed = _lastShowSettings && !ShowSettings;
            if (_lastFocusedIndex != CurrentIndex || firstRender || settingsClosed)
            {
                _lastFocusedIndex = CurrentIndex;
                await FocusOverlayAsync();
            }
        }
        _lastShowSettings = ShowSettings;
    }

    [JSInvokable]
    public Task OnDisplayModeChanged(bool immersive)
    {
        if (_disposed || IsImmersive == immersive) return Task.CompletedTask;

        IsImmersive = immersive;
        if (IsImmersive)
        {
            ShowSettings = false;
            _showChrome = false;
        }
        return InvokeAsync(StateHasChanged);
    }

    private async Task FocusOverlayAsync()
    {
        try
        {
            await _overlayDiv.FocusAsync();
        }
        catch
        {
            // Ignore focus errors during prerender/dispose
        }
    }

    private async Task LoadPhotosAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var isAdmin = authState.User.IsInRole(RoleNames.Admin);

            var allPhotos = await PhotoService.GetAllPhotosByFolderIdAsync(FolderId);
            Photos = isAdmin
                ? allPhotos
                : allPhotos.Where(p => p.IsVisible).ToList();

            if (Photos.Any())
            {
                CurrentIndex = 0;
                _enterAnimKey++;
                if (IsPlaying)
                {
                    StartTimer();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading photos for slideshow in folder {FolderId}", FolderId);
            Photos = new();
        }
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        var seconds = Settings.SecondsPerImage;
        _timer = new System.Threading.Timer(OnTimerTick, null, TimeSpan.FromSeconds(seconds), TimeSpan.FromSeconds(seconds));
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    private void RestartTimer()
    {
        if (IsPlaying)
        {
            StartTimer();
        }
    }

    private void OnTimerTick(object? state)
    {
        if (_disposed) return;

        try
        {
            _ = InvokeAsync(async () =>
            {
                if (_disposed) return;

                try
                {
                    if (IsPlaying && Photos != null && Photos.Any())
                    {
                        await NextPhotoAsync();
                    }
                }
                catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException)
                {
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error during slideshow timer tick execution");
                }
            });
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException)
        {
        }
    }

    private async Task GoToIndexAsync(int newIndex)
    {
        if (Photos == null || !Photos.Any() || newIndex == CurrentIndex) return;

        var previousId = Photos[CurrentIndex].Id;
        CurrentIndex = newIndex;
        _enterAnimKey++;

        if (Settings.Transition != "None")
        {
            _outgoingPhotoId = previousId;
            ScheduleClearOutgoing();
        }
        else
        {
            _outgoingPhotoId = null;
        }

        RestartTimer();
        PrefetchNearby();
        await InvokeAsync(StateHasChanged);
    }

    private void ScheduleClearOutgoing()
    {
        _transitionCts?.Cancel();
        _transitionCts?.Dispose();
        _transitionCts = new CancellationTokenSource();
        var token = _transitionCts.Token;
        var delay = Settings.Transition == "Slide" ? SlideDuration : FadeDuration;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, token);
                if (token.IsCancellationRequested || _disposed) return;
                await InvokeAsync(() =>
                {
                    _outgoingPhotoId = null;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
            }
        }, token);
    }

    private void PrefetchNearby()
    {
        if (Photos == null || Photos.Count < 2) return;

        // Warm the browser cache for neighbors (best-effort; no await).
        var next = CurrentIndex < Photos.Count - 1 ? CurrentIndex + 1 : (Settings.Loop ? 0 : -1);
        var prev = CurrentIndex > 0 ? CurrentIndex - 1 : (Settings.Loop ? Photos.Count - 1 : -1);
        _ = PrefetchIdAsync(next >= 0 ? Photos[next].Id : null);
        _ = PrefetchIdAsync(prev >= 0 ? Photos[prev].Id : null);
    }

    private async Task PrefetchIdAsync(int? photoId)
    {
        if (photoId is null || _jsModule is null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("prefetchImage",
                $"/api/images/web/{photoId}?max=2000&watermark=true");
        }
        catch
        {
            // Prefetch is optional
        }
    }

    private void OnIncomingImageLoaded()
    {
        // Dual-layer CSS handles transition timing; load event kept for future hooks.
    }

    private async Task NextPhotoAsync()
    {
        if (Photos == null || !Photos.Any()) return;

        if (CurrentIndex < Photos.Count - 1)
        {
            await GoToIndexAsync(CurrentIndex + 1);
        }
        else if (Settings.Loop)
        {
            await GoToIndexAsync(0);
        }
        else
        {
            IsPlaying = false;
            StopTimer();
        }
    }

    private async Task PrevPhotoAsync()
    {
        if (Photos == null || !Photos.Any()) return;

        if (CurrentIndex > 0)
        {
            await GoToIndexAsync(CurrentIndex - 1);
        }
        else if (Settings.Loop)
        {
            await GoToIndexAsync(Photos.Count - 1);
        }
    }

    private void TogglePlay()
    {
        IsPlaying = !IsPlaying;
        if (IsPlaying)
        {
            StartTimer();
        }
        else
        {
            StopTimer();
        }
        StateHasChanged();
    }

    private void ToggleSettings()
    {
        ShowSettings = !ShowSettings;
        if (ShowSettings)
        {
            RevealChrome();
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        if (_jsModule is null) return;
        try
        {
            await _jsModule.InvokeAsync<bool>("toggleFullscreen", _overlayDiv);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling slideshow fullscreen");
        }
    }

    private void HandleMouseMove()
    {
        if (!IsImmersive) return;

        // Throttle StateHasChanged noise
        var now = DateTime.UtcNow;
        if ((now - _lastMouseMoveUtc).TotalMilliseconds < 200 && _showChrome) return;
        _lastMouseMoveUtc = now;
        RevealChrome();
    }

    private void RevealChrome()
    {
        _showChrome = true;
        _chromeHideTimer?.Dispose();
        _chromeHideTimer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            _ = InvokeAsync(() =>
            {
                if (ShowSettings) return;
                _showChrome = false;
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(2.5), Timeout.InfiniteTimeSpan);
        StateHasChanged();
    }

    private async Task OnSecondsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            Settings.SecondsPerImage = seconds;
            await SaveSettingsAsync();
            RestartTimer();
        }
    }

    private async Task OnTransitionChanged(ChangeEventArgs e)
    {
        Settings.Transition = e.Value?.ToString() ?? "Fade";
        await SaveSettingsAsync();
    }

    private async Task OnLoopChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var loop))
        {
            Settings.Loop = loop;
            await SaveSettingsAsync();
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("saveSettings", Settings);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving slideshow settings to localStorage");
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == " ")
        {
            TogglePlay();
        }
        else if (e.Key == "ArrowLeft")
        {
            await PrevPhotoAsync();
        }
        else if (e.Key == "ArrowRight")
        {
            await NextPhotoAsync();
        }
        else if (e.Key == "f" || e.Key == "F")
        {
            await ToggleFullscreenAsync();
        }
        else if (e.Key == "Escape")
        {
            if (IsImmersive && _jsModule != null)
            {
                try
                {
                    await _jsModule.InvokeVoidAsync("exitFullscreen");
                    return;
                }
                catch
                {
                    // Fall through to close if exit fails (e.g. F11-only immersive)
                }
            }
            await CloseOverlayAsync();
        }
    }

    private async Task CloseOverlayAsync()
    {
        StopTimer();
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("exitFullscreen");
            }
            catch
            {
            }
        }

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopTimer();
        _chromeHideTimer?.Dispose();
        _transitionCts?.Cancel();
        _transitionCts?.Dispose();

        if (_displaySubscription != null)
        {
            try
            {
                await _displaySubscription.InvokeVoidAsync("dispose");
                await _displaySubscription.DisposeAsync();
            }
            catch
            {
            }
        }

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (InvalidOperationException)
            {
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error disposing slideshow settings JS module");
            }
        }

        _dotNetRef?.Dispose();
    }
}
