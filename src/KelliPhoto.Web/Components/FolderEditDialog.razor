@using KelliPhoto.Web.Data.Models
@using KelliPhoto.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using SixLabors.ImageSharp
@inject IFolderService FolderService
@inject IPhotoService PhotoService
@inject IPathService PathService
@inject ITagService TagService
@inject ILogger<FolderEditDialog> Logger

@if (IsOpen && _folder != null)
{
    <div class="folder-edit-backdrop" @onclick="Close">
        <div class="folder-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="folder-edit-title" @onclick:stopPropagation="true">
            <header class="folder-edit-header">
                <h5 id="folder-edit-title" class="folder-edit-title">Edit album</h5>
                <button type="button" class="folder-edit-close" aria-label="Close" @onclick="Close">&times;</button>
            </header>

            <div class="folder-edit-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger py-2">@_errorMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="folder-edit-name">Name</label>
                    <input id="folder-edit-name" class="form-control" @bind="_name" maxlength="500" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="folder-edit-position">Position in parent folder</label>
                    <select id="folder-edit-position" class="form-select" @bind="_positionIndex">
                        @for (var i = 0; i < _positionOptions; i++)
                        {
                            <option value="@i">@(i + 1)@(_positionOptions == 1 ? " (only)" : "")</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="folder-edit-visible" @bind="_isVisible" />
                        <label class="form-check-label" for="folder-edit-visible">Visible in gallery</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="folder-edit-description">Description</label>
                    <textarea id="folder-edit-description" class="form-control" rows="2" @bind="_description"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Album tags</label>
                    <div class="folder-edit-tag-list">
                        @if (_tags.Count == 0)
                        {
                            <span class="folder-edit-hint text-muted small mb-0">No tags yet.</span>
                        }
                        else
                        {
                            @foreach (var tag in _tags)
                            {
                                <span class="folder-edit-tag-chip">
                                    @tag.Name
                                    @if (!string.IsNullOrEmpty(tag.Group))
                                    {
                                        <span class="folder-edit-tag-group">@tag.Group</span>
                                    }
                                    <button type="button"
                                            class="folder-edit-tag-remove"
                                            title="Remove @tag.Name"
                                            aria-label="Remove @tag.Name"
                                            disabled="@_isSaving"
                                            @onclick="() => DetachTagAsync(tag.Id)">
                                        &times;
                                    </button>
                                </span>
                            }
                        }
                    </div>

                    <div class="folder-edit-tag-add mt-2">
                        <input id="folder-edit-tag-input"
                               class="form-control"
                               placeholder="Add tag…"
                               autocomplete="off"
                               list="folder-edit-tag-suggestions"
                               value="@_tagInput"
                               @oninput="OnTagInputChanged"
                               @onkeydown="OnTagInputKeyDown"
                               disabled="@_isSaving" />
                        <datalist id="folder-edit-tag-suggestions">
                            @foreach (var suggestion in _tagSuggestions)
                            {
                                <option value="@suggestion.Name"></option>
                            }
                        </datalist>
                        <select class="form-select folder-edit-tag-group-select"
                                @bind="_tagGroup"
                                disabled="@_isSaving"
                                title="Optional group for new tags">
                            <option value="">No group</option>
                            @foreach (var group in _suggestedGroups)
                            {
                                <option value="@group">@group</option>
                            }
                        </select>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@(_isSaving || string.IsNullOrWhiteSpace(_tagInput))"
                                @onclick="AttachTagFromInputAsync">
                            Add
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_tagMessage))
                    {
                        <p class="small mt-1 @(_tagMessage.StartsWith("Error") ? "text-danger" : "text-muted")">@_tagMessage</p>
                    }
                </div>

                <hr class="folder-edit-divider" />

                <h6 class="folder-edit-section-title">Thumbnail@( _hasChildAlbums ? "s (up to 4)" : "")</h6>
                <p class="folder-edit-hint text-muted small">
                    @if (_hasChildAlbums)
                    {
                        <text>Album folders can use up to four covers. Pick from this folder, subfolders, or upload.</text>
                    }
                    else
                    {
                        <text>Choose one image from this folder or upload a new cover.</text>
                    }
                </p>

                @if (_savedCovers.Any())
                {
                    <div class="folder-edit-cover-preview">
                        @foreach (var cover in _savedCovers)
                        {
                            <img src="/api/images/thumbnail/@cover.Id?size=120" alt="Cover" />
                        }
                    </div>
                }

                <div class="folder-edit-cover-tabs" role="tablist">
                    <button type="button"
                            class="folder-edit-tab @(_coverSource == CoverSource.Folder ? "active" : "")"
                            @onclick="() => SetCoverSource(CoverSource.Folder)">
                        This folder
                    </button>
                    @if (_subfolderPhotos.Any())
                    {
                        <button type="button"
                                class="folder-edit-tab @(_coverSource == CoverSource.Subfolders ? "active" : "")"
                                @onclick="() => SetCoverSource(CoverSource.Subfolders)">
                            Subfolders
                        </button>
                    }
                    <button type="button"
                            class="folder-edit-tab @(_coverSource == CoverSource.Upload ? "active" : "")"
                            @onclick="() => SetCoverSource(CoverSource.Upload)">
                        Upload
                    </button>
                </div>

                @if (_coverSource == CoverSource.Upload)
                {
                    <div class="folder-edit-upload mt-2">
                        <InputFile class="form-control" OnChange="OnUploadSelected" accept="image/*" />
                        @if (_pendingUpload != null)
                        {
                            <p class="small text-muted mt-1 mb-0">Selected: @_pendingUpload.Name</p>
                        }
                    </div>
                }
                else if (_isLoadingPhotos)
                {
                    <p class="text-muted small mt-2">Loading photos…</p>
                }
                else
                {
                    var pickerPhotos = _coverSource == CoverSource.Folder ? _folderPhotos : _subfolderPhotos;
                    @if (pickerPhotos.Any())
                    {
                        <p class="small text-muted mt-2 mb-1">@_selectedCoverIds.Count / @_maxCovers selected (click to toggle)</p>
                        <div class="folder-edit-photo-grid">
                            @foreach (var photo in pickerPhotos)
                            {
                                var selected = _selectedCoverIds.Contains(photo.Id);
                                <button type="button"
                                        class="folder-edit-photo-btn @(selected ? "selected" : "")"
                                        title="@photo.Filename"
                                        @onclick="() => ToggleCover(photo.Id)">
                                    <img src="/api/images/thumbnail/@photo.Id?size=150" alt="" loading="lazy" />
                                    @if (_coverSource == CoverSource.Subfolders && photo.Folder != null)
                                    {
                                        <span class="folder-edit-photo-label">@photo.Folder.Name</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mt-2">No photos here. Use Upload or add images to the folder first.</p>
                    }
                }

                @if (!string.IsNullOrEmpty(_coverMessage))
                {
                    <p class="small mt-2 @(_coverMessage.StartsWith("Error") ? "text-danger" : "text-success")">@_coverMessage</p>
                }
            </div>

            <footer class="folder-edit-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearCovers" disabled="@_isSaving">Use automatic</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Close" disabled="@_isSaving">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_isSaving">
                    @(_isSaving ? "Saving…" : "Save")
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private enum CoverSource { Folder, Subfolders, Upload }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int? FolderId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private Folder? _folder;
    private string _originalName = "";
    private string _name = "";
    private string? _description;
    private bool _isVisible = true;
    private int _positionIndex;
    private int _positionOptions = 1;
    private bool _hasChildAlbums;
    private int _maxCovers = 1;

    private List<Photo> _folderPhotos = new();
    private List<Photo> _subfolderPhotos = new();
    private List<Photo> _savedCovers = new();
    private List<int> _selectedCoverIds = new();
    private CoverSource _coverSource = CoverSource.Folder;
    private IBrowserFile? _pendingUpload;
    private bool _coversCleared;

    private List<Tag> _tags = new();
    private string _tagInput = "";
    private string _tagGroup = "";
    private List<Tag> _tagSuggestions = new();
    private IReadOnlyList<string> _suggestedGroups = Array.Empty<string>();
    private string? _tagMessage;

    private const long MaxCoverUploadBytes = 15 * 1024 * 1024;

    private bool _isLoadingPhotos;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _coverMessage;
    private int? _lastLoadedFolderId;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || !FolderId.HasValue)
        {
            return;
        }

        if (_lastLoadedFolderId == FolderId)
        {
            return;
        }

        await LoadAsync(FolderId.Value);
    }

    private async Task LoadAsync(int folderId)
    {
        _lastLoadedFolderId = folderId;
        _errorMessage = null;
        _coverMessage = null;
        _tagMessage = null;
        _pendingUpload = null;
        _coversCleared = false;
        _isSaving = false;
        _tagInput = "";
        _tagGroup = "";
        _tagSuggestions = new();

        try
        {
            _folder = await FolderService.GetFolderByIdAsync(folderId);
            if (_folder == null)
            {
                _errorMessage = "Folder not found.";
                return;
            }

            _originalName = _folder.Name;
            _name = _folder.Name;
            _description = _folder.Description;
            _isVisible = _folder.IsVisible;

            var siblings = (await FolderService.GetSiblingFoldersAsync(folderId, includeHidden: true)).ToList();
            _positionOptions = Math.Max(1, siblings.Count);
            _positionIndex = siblings.FindIndex(s => s.Id == folderId);
            if (_positionIndex < 0)
            {
                _positionIndex = 0;
            }

            _hasChildAlbums = await FolderService.FolderHasChildrenAsync(folderId, includeHidden: true);
            _maxCovers = _hasChildAlbums ? 4 : 1;

            _savedCovers = (await FolderService.GetFolderCoverPhotosAsync(folderId)).ToList();
            _selectedCoverIds = _savedCovers.Select(p => p.Id).ToList();

            _tags = await TagService.GetTagsForFolderAsync(folderId);
            _suggestedGroups = TagService.ListSuggestedGroups();

            _isLoadingPhotos = true;
            _folderPhotos = (await FolderService.GetPhotosInFolderForCoverPickerAsync(folderId)).ToList();
            var allPicker = (await FolderService.GetPhotosForCoverPickerAsync(folderId)).ToList();
            _subfolderPhotos = allPicker.Where(p => p.FolderId != folderId).ToList();
            _isLoadingPhotos = false;

            _coverSource = _folderPhotos.Any()
                ? CoverSource.Folder
                : _subfolderPhotos.Any()
                    ? CoverSource.Subfolders
                    : CoverSource.Upload;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load folder edit dialog for {FolderId}", folderId);
            _errorMessage = $"Could not load folder: {ex.Message}";
        }
    }

    private async Task OnTagInputChanged(ChangeEventArgs e)
    {
        _tagInput = e.Value?.ToString() ?? "";
        _tagMessage = null;

        if (string.IsNullOrWhiteSpace(_tagInput))
        {
            _tagSuggestions = new();
            return;
        }

        try
        {
            _tagSuggestions = await TagService.AutocompleteAsync(_tagInput.Trim(), take: 12);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Tag autocomplete failed");
            _tagSuggestions = new();
        }
    }

    private async Task OnTagInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AttachTagFromInputAsync();
        }
    }

    private async Task AttachTagFromInputAsync()
    {
        if (!FolderId.HasValue || string.IsNullOrWhiteSpace(_tagInput))
        {
            return;
        }

        var name = _tagInput.Trim();
        _tagMessage = null;

        try
        {
            var group = string.IsNullOrWhiteSpace(_tagGroup) ? null : _tagGroup.Trim();
            var tag = await TagService.EnsureTagAsync(name, group);
            await TagService.AttachToFolderAsync(FolderId.Value, tag.Id);
            _tags = await TagService.GetTagsForFolderAsync(FolderId.Value);
            _tagInput = "";
            _tagSuggestions = new();
            _tagMessage = $"Added “{tag.Name}”.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to attach tag to folder {FolderId}", FolderId);
            _tagMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DetachTagAsync(int tagId)
    {
        if (!FolderId.HasValue)
        {
            return;
        }

        _tagMessage = null;
        try
        {
            await TagService.DetachFromFolderAsync(FolderId.Value, tagId);
            _tags = await TagService.GetTagsForFolderAsync(FolderId.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to detach tag {TagId} from folder {FolderId}", tagId, FolderId);
            _tagMessage = $"Error: {ex.Message}";
        }
    }

    private void SetCoverSource(CoverSource source)
    {
        _coverSource = source;
        _coverMessage = null;
        if (source != CoverSource.Upload)
        {
            _pendingUpload = null;
        }
    }

    private void ToggleCover(int photoId)
    {
        _coversCleared = false;
        if (_selectedCoverIds.Contains(photoId))
        {
            _selectedCoverIds.Remove(photoId);
        }
        else if (_selectedCoverIds.Count < _maxCovers)
        {
            _selectedCoverIds.Add(photoId);
        }

        _coverMessage = null;
    }

    private void OnUploadSelected(InputFileChangeEventArgs e)
    {
        _pendingUpload = e.File;
        _coverSource = CoverSource.Upload;
        _coverMessage = null;
        _coversCleared = false;
    }

    private async Task SaveAsync()
    {
        if (_folder == null || !FolderId.HasValue)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        _coverMessage = null;
        var renameSucceeded = false;

        try
        {
            var trimmedName = (_name ?? "").Trim();
            if (string.IsNullOrEmpty(trimmedName))
            {
                throw new InvalidOperationException("Folder name is required.");
            }

            var nameChanged = !string.Equals(trimmedName, _originalName, StringComparison.Ordinal);
            if (nameChanged)
            {
                await FolderService.RenameAlbumAsync(FolderId.Value, trimmedName);
                renameSucceeded = true;
                // Reload so subsequent settings update uses disk-sanitized name.
                var renamed = await FolderService.GetFolderByIdAsync(FolderId.Value)
                    ?? throw new InvalidOperationException("Folder not found after rename.");
                trimmedName = renamed.Name;
                _originalName = renamed.Name;
                _name = renamed.Name;
                _folder = renamed;
            }

            await FolderService.UpdateFolderSettingsAsync(
                FolderId.Value,
                trimmedName,
                _positionIndex,
                _isVisible,
                _description);

            if (_pendingUpload != null)
            {
                await UploadCoverAsync(_pendingUpload);
            }

            if (_coversCleared || (_selectedCoverIds.Count == 0 && _savedCovers.Count > 0))
            {
                await FolderService.ClearFolderCoverPhotosAsync(FolderId.Value);
            }
            else if (CoversSelectionChanged())
            {
                await FolderService.SetFolderCoverPhotosAsync(FolderId.Value, _selectedCoverIds);
            }

            await OnSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving folder {FolderId}", FolderId);
            _errorMessage = ex.Message;
            // Rename already persisted — notify parents so tree/browser names refresh while keeping the error visible.
            if (renameSucceeded && OnSaved.HasDelegate)
            {
                try
                {
                    await OnSaved.InvokeAsync();
                }
                catch (Exception notifyEx)
                {
                    Logger.LogWarning(notifyEx, "OnSaved after partial rename failure for folder {FolderId}", FolderId);
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private bool CoversSelectionChanged()
    {
        if (_selectedCoverIds.Count != _savedCovers.Count)
        {
            return true;
        }

        var savedIds = _savedCovers.Select(p => p.Id).ToList();
        for (var i = 0; i < _selectedCoverIds.Count; i++)
        {
            if (_selectedCoverIds[i] != savedIds[i])
            {
                return true;
            }
        }

        return false;
    }

    private async Task UploadCoverAsync(IBrowserFile file)
    {
        var folder = await FolderService.GetFolderByIdAsync(FolderId!.Value)
            ?? throw new InvalidOperationException("Folder not found.");

        var folderPath = PathService.GetFullPath(folder.Path);
        Directory.CreateDirectory(folderPath);

        await using var stream = file.OpenReadStream(maxAllowedSize: MaxCoverUploadBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        buffer.Position = 0;

        ImageInfo? imageInfo;
        try
        {
            imageInfo = Image.Identify(buffer);
        }
        catch (UnknownImageFormatException)
        {
            throw new InvalidOperationException("The selected file is not a valid image.");
        }

        if (imageInfo is null)
        {
            throw new InvalidOperationException("The selected file is not a valid image.");
        }

        var extension = Path.GetExtension(file.Name);
        if (string.IsNullOrEmpty(extension)
            && imageInfo.Metadata.DecodedImageFormat?.FileExtensions.FirstOrDefault() is { } formatExt)
        {
            extension = "." + formatExt;
        }

        if (string.IsNullOrEmpty(extension))
        {
            extension = ".jpg";
        }

        var safeName = Guid.NewGuid().ToString("N") + extension.ToLowerInvariant();
        var filePath = Path.Combine(folderPath, safeName);
        buffer.Position = 0;
        await using (var fileStream = new FileStream(filePath, FileMode.Create))
        {
            await buffer.CopyToAsync(fileStream);
        }

        var photo = await PhotoService.CreateOrUpdatePhotoAsync(filePath, FolderId!.Value, safeName);
        _selectedCoverIds = _hasChildAlbums
            ? new List<int> { photo.Id }.Concat(_selectedCoverIds).Take(_maxCovers).ToList()
            : new List<int> { photo.Id };
        _coversCleared = false;
    }

    private void ClearCovers()
    {
        if (!FolderId.HasValue)
        {
            return;
        }

        _selectedCoverIds.Clear();
        _savedCovers.Clear();
        _pendingUpload = null;
        _coversCleared = true;
        _coverMessage = "Automatic thumbnails will be used when you save.";
    }

    private async Task Close()
    {
        _lastLoadedFolderId = null;
        _folder = null;
        await OnClose.InvokeAsync();
    }
}
