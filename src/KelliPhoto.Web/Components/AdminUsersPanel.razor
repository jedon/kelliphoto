@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using KelliPhoto.Web.Services
@inject IUserManagementService UserManagement
@inject AuthenticationStateProvider AuthStateProvider

<div class="admin-users-panel">
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertError ? "alert-danger" : "alert-success") mb-3" role="alert">@alertMessage</div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Create user</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="create-email">Email</label>
                    <input id="create-email" type="email" class="form-control" @bind="createEmail" disabled="@isBusy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="create-password">Password</label>
                    <input id="create-password" type="password" class="form-control" @bind="createPassword" disabled="@isBusy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="create-confirm">Confirm password</label>
                    <input id="create-confirm" type="password" class="form-control" @bind="createConfirmPassword" disabled="@isBusy" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input id="create-admin" class="form-check-input" type="checkbox" @bind="createGrantAdmin" disabled="@isBusy" />
                        <label class="form-check-label" for="create-admin">Grant admin role</label>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary mt-3" @onclick="CreateUserAsync" disabled="@isBusy">
                @(isCreating ? "Creating…" : "Create user")
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Users</h5>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadUsersAsync" disabled="@isBusy">Refresh</button>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <p class="text-muted p-3 mb-0">Loading users…</p>
            }
            else if (!users.Any())
            {
                <p class="text-muted p-3 mb-0">No users found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                var isSelf = user.Id == currentUserId;
                                var isLastAdmin = user.IsAdmin && adminCount == 1;
                                <tr>
                                    <td>
                                        @user.Email
                                        @if (isSelf)
                                        {
                                            <span class="badge bg-secondary ms-1">You</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsAdmin)
                                        {
                                            <span class="badge bg-primary">Admin</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-warning text-dark">Locked</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (pendingAdminUserId == user.Id)
                                        {
                                            <span class="small text-muted me-2">
                                                @(isLastAdmin ? "Remove the last admin?" : "Remove admin role?")
                                            </span>
                                            <button class="btn btn-warning btn-sm" @onclick="() => ConfirmToggleAdminAsync(user)" disabled="@isBusy">Confirm</button>
                                            <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="CancelPending" disabled="@isBusy">Cancel</button>
                                        }
                                        else if (pendingDeleteUserId == user.Id)
                                        {
                                            <span class="small text-muted me-2">Delete this user?</span>
                                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteAsync(user.Id)" disabled="@isBusy">Confirm</button>
                                            <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="CancelPending" disabled="@isBusy">Cancel</button>
                                        }
                                        else
                                        {
                                            @if (user.IsAdmin)
                                            {
                                                <button class="btn btn-outline-warning btn-sm" @onclick="() => StartRemoveAdmin(user)" disabled="@isBusy">Remove admin</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => GrantAdminAsync(user.Id)" disabled="@isBusy">Make admin</button>
                                            }
                                            @if (user.IsLockedOut)
                                            {
                                                <button class="btn btn-outline-success btn-sm ms-1" @onclick="() => SetLockoutAsync(user.Id, locked: false)" disabled="@isBusy">Unlock</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => SetLockoutAsync(user.Id, locked: true)" disabled="@isBusy">Lock</button>
                                            }
                                            <button class="btn btn-outline-danger btn-sm ms-1"
                                                    @onclick="() => StartDelete(user.Id)"
                                                    disabled="@(isBusy || isSelf)"
                                                    title="@(isSelf ? "You cannot delete your own account" : null)">
                                                Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<UserSummaryDto> users = Array.Empty<UserSummaryDto>();
    private string? currentUserId;
    private int adminCount;
    private bool isLoading = true;
    private bool isCreating;
    private bool isBusy;
    private string? alertMessage;
    private bool isAlertError;

    private string createEmail = "";
    private string createPassword = "";
    private string createConfirmPassword = "";
    private bool createGrantAdmin;

    private string? pendingAdminUserId;
    private string? pendingDeleteUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = users.Count == 0;
        ClearAlert();
        try
        {
            users = await UserManagement.ListUsersAsync();
            adminCount = users.Count(u => u.IsAdmin);
        }
        catch (Exception)
        {
            ShowAlert("Failed to load users.", error: true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateUserAsync()
    {
        ClearAlert();

        if (string.IsNullOrWhiteSpace(createEmail))
        {
            ShowAlert("Email is required.", error: true);
            return;
        }

        if (string.IsNullOrEmpty(createPassword))
        {
            ShowAlert("Password is required.", error: true);
            return;
        }

        if (createPassword != createConfirmPassword)
        {
            ShowAlert("Passwords do not match.", error: true);
            return;
        }

        isCreating = true;
        isBusy = true;
        try
        {
            var result = await UserManagement.CreateUserAsync(createEmail.Trim(), createPassword, createGrantAdmin);
            if (result.Succeeded)
            {
                var createdEmail = createEmail.Trim();
                createEmail = "";
                createPassword = "";
                createConfirmPassword = "";
                createGrantAdmin = false;
                ShowAlert($"User {createdEmail} created successfully.", error: false);
                await LoadUsersAsync();
            }
            else
            {
                ShowAlert(FormatErrors(result), error: true);
            }
        }
        finally
        {
            isCreating = false;
            isBusy = false;
        }
    }

    private void StartRemoveAdmin(UserSummaryDto user)
    {
        ClearAlert();
        pendingDeleteUserId = null;
        pendingAdminUserId = user.Id;
    }

    private void StartDelete(string userId)
    {
        ClearAlert();
        pendingAdminUserId = null;
        pendingDeleteUserId = userId;
    }

    private void CancelPending()
    {
        pendingAdminUserId = null;
        pendingDeleteUserId = null;
    }

    private async Task ConfirmToggleAdminAsync(UserSummaryDto user)
    {
        pendingAdminUserId = null;
        await SetAdminAsync(user.Id, isAdmin: false);
    }

    private async Task GrantAdminAsync(string userId) =>
        await SetAdminAsync(userId, isAdmin: true);

    private async Task SetAdminAsync(string userId, bool isAdmin)
    {
        isBusy = true;
        ClearAlert();
        try
        {
            var result = await UserManagement.SetAdminRoleAsync(userId, isAdmin, currentUserId);
            if (result.Succeeded)
            {
                ShowAlert(isAdmin ? "Admin role granted." : "Admin role removed.", error: false);
                await LoadUsersAsync();
            }
            else
            {
                ShowAlert(FormatErrors(result), error: true);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SetLockoutAsync(string userId, bool locked)
    {
        isBusy = true;
        ClearAlert();
        try
        {
            var result = await UserManagement.SetLockoutAsync(userId, locked);
            if (result.Succeeded)
            {
                ShowAlert(locked ? "User locked." : "User unlocked.", error: false);
                await LoadUsersAsync();
            }
            else
            {
                ShowAlert(FormatErrors(result), error: true);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmDeleteAsync(string userId)
    {
        pendingDeleteUserId = null;
        isBusy = true;
        ClearAlert();
        try
        {
            var result = await UserManagement.DeleteUserAsync(userId, currentUserId);
            if (result.Succeeded)
            {
                ShowAlert("User deleted.", error: false);
                await LoadUsersAsync();
            }
            else
            {
                ShowAlert(FormatErrors(result), error: true);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowAlert(string message, bool error)
    {
        alertMessage = message;
        isAlertError = error;
    }

    private void ClearAlert() => alertMessage = null;

    private static string FormatErrors(IdentityResult result) =>
        string.Join(" ", result.Errors.Select(e => e.Description));
}
