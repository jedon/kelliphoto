{
  "GallerySettings": {
    "GalleryPath": "/mnt/gallery/source",
    "ThumbnailPath": "/app/data/thumbnails",
    "WebImagePath": "/app/data/web",
    "WebAssetsPath": "/mnt/gallery/.web",
    "WebJpegQuality": 85,
    "LegacyWindowsGalleryRoot": "",
    "LegacyWindowsLocalMountPath": "",
    "FolderNameAliases": {
      "Events": "events",
      "Facebook photographs": "facebook_photographs",
      "Fine Art": "fine_art",
      "Oil painting references": "oil_painting_references",
      "Photojournalism": "photojournalism",
      "Photos for Mackenzie's photography class": "photos_for_mackenzie_s_photography_class",
      "SCA Galleries - Esmeralda of the Lakes": "sca_galleries_-_esmeralda_of_the_lakes",
      "Son of Monsterpalooza, September, 2022_ A LIVE performance of the Damn Dirty Drive-in radio comedy _Albert Kitschlock Presents The Films the Blew Too Much!_": "son_of_monsterpalooza_september_2022__a_live_performance_of_the_damn_dirty_drive-in_radio_comedy__albert_kitschlock_presents_the_films_the_blew_too_much__",
      "The Thinking Cap Company": "the_thinking_cap_company",
      "Wedding and Engagement Photographs": "wedding_and_engagement_photographs"
    }
  },
  "WatermarkSettings": {
    "Enabled": true,
    "ImagePath": "/mnt/gallery/.web/watermark.png",
    "Opacity": 0.28,
    "RelativeWidth": 0.22,
    "MarginPx": 24
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "KelliPhoto.Web": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/kelliphoto-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "KelliPhoto.Web": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "AllowRegistration": false
  },
  "Admin": {
    "Email": "admin@kelliphoto.com",
    "Password": "Admin123!"
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "FromEmail": "noreply@example.com",
    "FromName": "Kelli Photo",
    "ContactEmail": "contact@example.com"
  }
}
